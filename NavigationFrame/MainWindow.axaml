<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UnrealFrontiersLauncher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="UnrealFrontiersLauncher.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Unreal Frontiers Launcher"
        Width="1280" Height="720"
        MinWidth="1024" MinHeight="640"
        Background="#100F12"
        Icon="/Assets/Images/logo.ico"
        CanResize="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">
    <Grid RowDefinitions="Auto,*">
        <!-- Title bar -->
        <Border Grid.Row="0" Background="#0C0B0E" Height="52" BorderBrush="#232127" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,0,8,0">
                <!-- Left: back + brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Classes="uf-ghost" Width="40" Height="36"
                            Click="GetToAuthPage" ToolTip.Tip="Back">
                        <Svg Path="/Assets/Images/svg/arrow_left.svg" Width="16" Height="16"/>
                    </Button>
                    <Image Source="{StaticResource UfLogoBadge}" Height="30" Stretch="Uniform"/>
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock x:Name="TitleText" Text="Unreal Frontiers" FontFamily="{StaticResource MontserratBold}" FontSize="14" Foreground="White" LineHeight="16"/>
                        <TextBlock Text="L A U N C H E R" FontFamily="{StaticResource MontserratRegular}" FontSize="9" Foreground="#7C828A" LineHeight="12" LetterSpacing="2"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center: drag area -->
                <Border Grid.Column="1" Background="Transparent" PointerPressed="OnTitleBarPointerPressed"/>

                <!-- Right: window controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Classes="uf-ghost" Width="44" Height="36" Click="OnMinimizeClick" ToolTip.Tip="Minimize">
                        <Svg Path="/Assets/Images/svg/dash.svg" Width="16" Height="16"/>
                    </Button>
                    <Button Classes="uf-ghost" Width="44" Height="36" Click="OnMaximizeClick" ToolTip.Tip="Maximize">
                        <Border Width="12" Height="12" BorderBrush="White" BorderThickness="1.6" CornerRadius="2"/>
                    </Button>
                    <Button Classes="uf-ghost" Width="44" Height="36" Click="OnCloseClick" ToolTip.Tip="Close">
                        <Svg Path="/Assets/Images/svg/close_app.svg" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Brand accent line -->
        <Border Grid.Row="0" Height="2" VerticalAlignment="Bottom" Background="{StaticResource UfAccentGradient}" Opacity="0.8"/>

        <!-- Page host -->
        <Grid x:Name="PageHost" Grid.Row="1" ClipToBounds="True"/>
    </Grid>
</Window>
