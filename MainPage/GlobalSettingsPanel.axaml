<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UnrealFrontiersLauncher.GlobalSettingsPanel">
    <Border Classes="uf-card" Padding="0" Width="500" MaxHeight="520" ClipToBounds="True">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Title -->
        <Border Grid.Row="0" Background="#0C0B0E" BorderBrush="#232127" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="10" Background="#26232C">
                        <Svg Path="/Assets/Images/svg/gear.svg" Width="18" Height="18"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Настройки лаунчера"
                                   FontFamily="{StaticResource MontserratBold}"
                                   FontSize="16" Foreground="White"/>
                        <TextBlock Text="Действуют для всех сборок"
                                   FontFamily="{StaticResource MontserratRegular}"
                                   FontSize="12" Foreground="#8E939B"/>
                    </StackPanel>
                </StackPanel>
                <Border Height="2" Width="64" CornerRadius="1" Margin="0,8,0,0"
                        HorizontalAlignment="Left"
                        Background="{StaticResource UfAccentGradient}"/>
            </StackPanel>
        </Border>

        <!-- Toggles -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="0" Margin="20,12">
                <StackPanel Spacing="6" Margin="0,8">
                    <TextBlock Text="Папка установки"
                               FontFamily="{StaticResource MontserratBold}"
                               Foreground="White" FontSize="14"/>
                    <TextBlock Text="Здесь лежат сборки и файлы игры. Настройки лаунчера остаются на месте."
                               FontFamily="{StaticResource MontserratRegular}"
                               Foreground="#8E939B" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock x:Name="InstallPathText"
                               FontFamily="{StaticResource MontserratRegular}"
                               Foreground="White" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock x:Name="InstallPathStatus" IsVisible="False"
                               FontFamily="{StaticResource MontserratRegular}"
                               Foreground="#E5484D" FontSize="12" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button x:Name="ChooseInstallPathButton" Classes="uf-accent" Click="OnChooseInstallPath"
                                HorizontalContentAlignment="Center" Content="Выбрать папку…"
                                FontFamily="{StaticResource MontserratBold}" FontSize="13"/>
                        <Button x:Name="ResetInstallPathButton" Click="OnResetInstallPath"
                                HorizontalContentAlignment="Center" Content="По умолчанию"
                                FontFamily="{StaticResource MontserratBold}" FontSize="13"/>
                    </StackPanel>
                </StackPanel>

                <Border Height="1" Background="#2E2C34" Margin="0,8"/>

                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8">
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12"
                            VerticalAlignment="Center" Background="#26232C" Margin="0,0,12,0">
                        <Svg Path="/Assets/Images/svg/console.svg" Width="22" Height="22"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Открыть консоль"
                                   FontFamily="{StaticResource MontserratBold}"
                                   Foreground="White" FontSize="14" TextWrapping="Wrap"/>
                        <TextBlock Text="Показывать окно логов игры при запуске"
                                   FontFamily="{StaticResource MontserratRegular}"
                                   Foreground="#8E939B" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="2" x:Name="OpenConsoleBox"
                                  Theme="{StaticResource UfSettingsToggle}" VerticalAlignment="Center"/>
                </Grid>

                <Border Height="1" Background="#2E2C34" Margin="0,8"/>

                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8">
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12"
                            VerticalAlignment="Center" Background="#26232C" Margin="0,0,12,0">
                        <Svg Path="/Assets/Images/svg/power.svg" Width="22" Height="22"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Закрыть лаунчер при запуске"
                                   FontFamily="{StaticResource MontserratBold}"
                                   Foreground="White" FontSize="14" TextWrapping="Wrap"/>
                        <TextBlock Text="Освобождает память во время игры"
                                   FontFamily="{StaticResource MontserratRegular}"
                                   Foreground="#8E939B" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="2" x:Name="CloseLauncherBox"
                                  Theme="{StaticResource UfSettingsToggle}" VerticalAlignment="Center"/>
                </Grid>

                <Border Height="1" Background="#2E2C34" Margin="0,8"/>

                <!-- Master animation switch -->
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8">
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12"
                            VerticalAlignment="Center" Background="#26232C" Margin="0,0,12,0">
                        <Svg Path="/Assets/Images/svg/sparkles.svg" Width="22" Height="22"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Анимации интерфейса"
                                   FontFamily="{StaticResource MontserratBold}"
                                   Foreground="White" FontSize="14" TextWrapping="Wrap"/>
                        <TextBlock Text="Выключает все эффекты ниже разом, экономит батарею"
                                   FontFamily="{StaticResource MontserratRegular}"
                                   Foreground="#8E939B" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="2" x:Name="UiAnimationsBox"
                                  Theme="{StaticResource UfSettingsToggle}" VerticalAlignment="Center"/>
                </Grid>

                <Border Height="1" Background="#2E2C34" Margin="0,8"/>

                <!-- Individual effects: dimmed + disabled while the master
                     switch is off (see UpdateEffectTogglesEnabled). -->
                <StackPanel x:Name="UiEffectsGroup" Spacing="0">
                <TextBlock Text="ОТДЕЛЬНЫЕ ЭФФЕКТЫ"
                           FontFamily="{StaticResource MontserratBold}"
                           Foreground="#5E6068" FontSize="11" Margin="0,8,0,0"/>

                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8">
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12"
                            VerticalAlignment="Center" Background="#26232C" Margin="0,0,12,0">
                        <Border Width="16" Height="16" CornerRadius="8"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{StaticResource UfAccentGradient}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Свечение кнопки «Играть!»"
                                   FontFamily="{StaticResource MontserratBold}"
                                   Foreground="White" FontSize="14" TextWrapping="Wrap"/>
                        <TextBlock Text="Дыхание градиента и mint-подсветка"
                                   FontFamily="{StaticResource MontserratRegular}"
                                   Foreground="#8E939B" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="2" x:Name="UiGlowBox"
                                  Theme="{StaticResource UfSettingsToggle}" VerticalAlignment="Center"/>
                </Grid>

                <Border Height="1" Background="#2E2C34" Margin="0,8"/>

                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8">
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12"
                            VerticalAlignment="Center" Background="#26232C" Margin="0,0,12,0">
                        <Svg Path="/Assets/Images/svg/arrow_left.svg" Width="22" Height="22"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Переходы между экранами"
                                   FontFamily="{StaticResource MontserratBold}"
                                   Foreground="White" FontSize="14" TextWrapping="Wrap"/>
                        <TextBlock Text="Слайд-анимация входа, главной и обновления"
                                   FontFamily="{StaticResource MontserratRegular}"
                                   Foreground="#8E939B" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="2" x:Name="UiTransitionsBox"
                                  Theme="{StaticResource UfSettingsToggle}" VerticalAlignment="Center"/>
                </Grid>

                <Border Height="1" Background="#2E2C34" Margin="0,8"/>

                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8">
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12"
                            VerticalAlignment="Center" Background="#26232C" Margin="0,0,12,0">
                        <Svg Path="/Assets/Images/svg/gear.svg" Width="22" Height="22"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Появление настроек"
                                   FontFamily="{StaticResource MontserratBold}"
                                   Foreground="White" FontSize="14" TextWrapping="Wrap"/>
                        <TextBlock Text="Затемнение фона и всплытие панели"
                                   FontFamily="{StaticResource MontserratRegular}"
                                   Foreground="#8E939B" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="2" x:Name="UiOverlayFadeBox"
                                  Theme="{StaticResource UfSettingsToggle}" VerticalAlignment="Center"/>
                </Grid>

                <Border Height="1" Background="#2E2C34" Margin="0,8"/>

                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8">
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12"
                            VerticalAlignment="Center" Background="#26232C" Margin="0,0,12,0">
                        <Border Width="16" Height="16" CornerRadius="8"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="#00FFA3" Opacity="0.7"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Пульсация загрузки"
                                   FontFamily="{StaticResource MontserratBold}"
                                   Foreground="White" FontSize="14" TextWrapping="Wrap"/>
                        <TextBlock Text="Мигание «Булдыга собирает чанки…»"
                                   FontFamily="{StaticResource MontserratRegular}"
                                   Foreground="#8E939B" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="2" x:Name="UiPulseBox"
                                  Theme="{StaticResource UfSettingsToggle}" VerticalAlignment="Center"/>
                </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Close -->
        <Border Grid.Row="2" Padding="16,12" BorderBrush="#232127" BorderThickness="0,1,0,0">
            <Button Classes="uf-accent" Click="OnCloseClicked"
                    HorizontalAlignment="Right" MinWidth="120"
                    HorizontalContentAlignment="Center"
                    Content="Готово"
                    FontFamily="{StaticResource MontserratBold}" FontSize="14"/>
        </Border>
    </Grid>
    </Border>
</UserControl>
