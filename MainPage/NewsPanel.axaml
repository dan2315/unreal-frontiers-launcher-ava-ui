<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ufl="using:UnrealFrontiersLauncher"
             x:DataType="ufl:NewsPanel"
             x:Class="UnrealFrontiersLauncher.NewsPanel">
    <Border Classes="uf-card" Padding="0" Width="480" MaxHeight="560" ClipToBounds="True">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Title -->
        <Border Grid.Row="0" Background="#0C0B0E" BorderBrush="#232127" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="10" Background="#26232C">
                        <Svg Path="/Assets/Images/svg/news.svg" Width="18" Height="18"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Новости"
                                   FontFamily="{StaticResource MontserratBold}"
                                   FontSize="16" Foreground="White"/>
                        <TextBlock Text="{Binding Subtitle}"
                                   FontFamily="{StaticResource MontserratRegular}"
                                   FontSize="12" Foreground="#8E939B"/>
                    </StackPanel>
                </StackPanel>
                <Border Height="2" Width="64" CornerRadius="1" Margin="0,8,0,0"
                        HorizontalAlignment="Left"
                        Background="{StaticResource UfAccentGradient}"/>
            </StackPanel>
        </Border>

        <!-- Entries -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="0" Margin="20,12,20,16">
                <TextBlock Text="{Binding Message}" IsVisible="{Binding HasMessage}"
                           FontFamily="{StaticResource MontserratRegular}"
                           FontSize="13" Foreground="#8E939B" TextWrapping="Wrap" Margin="0,8"/>
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="ufl:NewsEntry">
                            <Border BorderBrush="#2E2C34" BorderThickness="0,0,0,1" Padding="0,10">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Margin="0,5,10,0"
                                            Background="{StaticResource UfMintBrush}"/>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{Binding Title}"
                                                   FontFamily="{StaticResource MontserratBold}"
                                                   FontSize="14" Foreground="White" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Body}"
                                                   FontFamily="{StaticResource MontserratRegular}"
                                                   FontSize="12" Foreground="#B9BDC2" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Top"
                                               FontFamily="{StaticResource MontserratRegular}"
                                               FontSize="11" Foreground="#5E6068">
                                        <Run Text="{Binding Marker}"/><Run Text="{Binding DateText}"/>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Close -->
        <Border Grid.Row="2" Padding="16,12" BorderBrush="#232127" BorderThickness="0,1,0,0">
            <Button Classes="uf-accent" Click="OnCloseClicked"
                    HorizontalAlignment="Right" MinWidth="120"
                    HorizontalContentAlignment="Center"
                    Content="Закрыть"
                    FontFamily="{StaticResource MontserratBold}" FontSize="14"/>
        </Border>
    </Grid>
    </Border>
</UserControl>
