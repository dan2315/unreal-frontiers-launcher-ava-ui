<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:launcher"
             Shell.NavBarIsVisible="False"
             x:Class="launcher.MainPage"
             Title="MainPage"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <local:MultiConditionColorConverter x:Key="MultiConditionColorConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Source="background_image.png"
               Aspect="AspectFill"
               Grid.ColumnSpan="2"/>
        <!-- left part -->
        <StackLayout BackgroundColor="#201E24"
                     Padding="20"
                     Grid.RowSpan="2"
                     WidthRequest="230">
            <Label Text="Modpacks"
                   FontSize="24"
                   TextColor="White"
                   Padding="20,0,0,0"
                   Margin="0,0,0,20"
                   FontFamily="MontserratBold"/>

            <!-- Modpack Selection -->
            <CollectionView x:Name="ModpackCollectionView"
                            SelectionMode="Single"
                            SelectionChanged="OnInstanceSelected"
                            SelectedItem="{Binding SelectedModpack}"
                            ItemsSource="{Binding Modpacks}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <StackLayout BackgroundColor="#201E24">
                            <!-- Modpack Item -->
                            <Frame BackgroundColor="{Binding BackgroundColor}"
                                   Margin="0,10,0,10"
                                   Padding="0,5,0,5"
                                   CornerRadius="10"
                                   HasShadow="False"
                                   VerticalOptions="Center"
                                   BorderColor="Transparent">
                                <Frame.GestureRecognizers>
                                    <PointerGestureRecognizer
                                        PointerEnteredCommand="{Binding PointerEnteredCommand}"
                                        PointerExitedCommand="{Binding PointerExitedCommand}"/>
                                </Frame.GestureRecognizers>

                                <HorizontalStackLayout Padding="10,5">
                                    <Image Source="{Binding Icon}"
                                           WidthRequest="30"
                                           HeightRequest="30"
                                           Margin="0,0,10,0"/>
                                    <Label Text="{Binding Name}"
                                           FontSize="16"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Center"
                                           TextColor="{Binding SelectionAndHoverState, Converter={StaticResource MultiConditionColorConverter}}"
                                           FontFamily="MontserratLight"/>
                                </HorizontalStackLayout>
                            </Frame>
                            <!-- Divider Line -->
                            <BoxView HeightRequest="1"
                                     Color="#404040"
                                     HorizontalOptions="Fill">
                                <BoxView.Triggers>
                                    <DataTrigger TargetType="BoxView"
                                                 Binding="{Binding IsLastItem}"
                                                 Value="True">
                                        <Setter Property="IsVisible"
                                                Value="False"/>
                                    </DataTrigger>
                                </BoxView.Triggers>
                            </BoxView>
                        </StackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <local:PrimaryButton ImageSource="settings.png"
                                 Text="Показать папку"
                                TextColor="#FFFFFF"
                                AutoLock="False"
                                 BackgroundColor="MediumPurple"
                                 FontFamily="MontserratRegular"
                                 VerticalOptions="EndAndExpand"
                                 Margin="0, 0, 0, 50"
                                 Clicked="OnShowFolderClicked"/>

        </StackLayout>



        <Border
            InputTransparent="True"
            StrokeThickness="0"
            Grid.ColumnSpan="2"
            HeightRequest="200"
            VerticalOptions="End">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,1"
                                     EndPoint="0,0">
                    <GradientStop Color="#83000000"
                                  Offset="0.0"/>
                    <GradientStop Color="Transparent"
                                  Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Right Part -->
        <StackLayout Grid.Column="2"
                     BackgroundColor="Transparent"
                     HorizontalOptions="FillAndExpand">

            <!-- Upper Part - Settings -->
            <HorizontalStackLayout Grid.Column="1"
                                   BackgroundColor="Transparent"
                                   HorizontalOptions="Fill"
                                   HeightRequest="76"
                                   Margin="20,0,0,0">

                <!-- Game Tab -->
                <local:TabView x:Name="GameTab"
                               Text="Играть!"
                               Icon="sword.png"
                               CommandParameter="game"/>

                <!-- Settings Tab -->
                <local:TabView x:Name="SettingsTab"
                               Text="Настройки"
                               Icon="settings.png"
                               CommandParameter="settings"/>

            </HorizontalStackLayout>

            <Grid ColumnDefinitions="*, Auto"
                    HeightRequest="470">
                <!--Settings Panel-->
                <Frame
                    Grid.Column="0"
                    IsVisible="{Binding IsSettingsPanelVisible}"
                    BackgroundColor="#201E24"
                    Margin="10">

                    <VerticalStackLayout>
                    
                    <Label FontFamily="MontserratBold" Margin="10" FontSize="18">Настройки</Label>

                    <HorizontalStackLayout
                            Spacing="15"
                            BackgroundColor="#44444444"
                            Padding="10, 2, 10, 2">
                            <Label Text="RAM: "
                                   VerticalOptions="Center"
                                   FontFamily="MontserratRegular"/>
                            <Slider x:Name="RamSlider"
                                WidthRequest="400"
                                    VerticalOptions="Center"/>
                            <Entry x:Name="RamEntry"
                                Keyboard="Numeric"
                                HeightRequest="0"
                                MaximumWidthRequest="140"
                                MinimumWidthRequest="140"
                                Scale="0.8"/>

                        </HorizontalStackLayout>

                        <HorizontalStackLayout
                            Spacing="15"
                            BackgroundColor="#44444444"
                            Padding="10, 2, 10, 2">
                            <Label Text="Открыть консоль: "
                                   VerticalOptions="Center"
                                   FontFamily="MontserratRegular"
                                   Margin="10"/>
                            <CheckBox IsEnabled="False"/>

                        </HorizontalStackLayout>

                                                <HorizontalStackLayout
                            Spacing="15"
                            BackgroundColor="#44444444"
                            Padding="10, 2, 10, 2">
                            <Label Text="Закрыть лаунчер при запуске: "
                                   VerticalOptions="Center"
                                   FontFamily="MontserratRegular"
                                   Margin="10"/>
                            <CheckBox IsEnabled="False"/>

                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                </Frame>

                <!--Player Profile-->
                <Frame
                    Grid.Column="1"
                    WidthRequest="250"
                    BackgroundColor="#201E24"
                    Margin="10"
                    Padding="5">
                    <VerticalStackLayout>

                        <Frame
                                HeightRequest="60"
                                BackgroundColor="#44444444">
                            <HorizontalStackLayout>
                                <Image Source="stevehead.png"
                                        WidthRequest="30"
                                        HeightRequest="30"></Image>
                                <Label Padding="10"
                                        VerticalTextAlignment="Center"
                                        FontFamily="MontserratRegular"
                                        Text="{Binding PlayerName}"/>
                            </HorizontalStackLayout>
                        </Frame>

                        <Label HeightRequest="276"></Label>

                        <Frame
                            HeightRequest="100"
                            BackgroundColor="#44444444">
                            <VerticalStackLayout>
                                <Label Padding="0,0,0,6"
                                       VerticalTextAlignment="Center"
                                       FontFamily="MontserratBold"
                                       Text="Выбранный сервер: "/>
                                <HorizontalStackLayout>
                                    <Image WidthRequest="30"
                                            Source="{Binding SelectedModpack.Icon}"/>
                                    <Label Padding="10"
                                           VerticalTextAlignment="Center"
                                           FontFamily="MontserratRegular"
                                           Text="{Binding SelectedModpack.Name}"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Frame>

                    </VerticalStackLayout>
                </Frame>

            </Grid>

            <!-- Lower Part - Progress and Launch Button -->
            <StackLayout VerticalOptions="EndAndExpand"
                         BackgroundColor="Transparent"
                         Padding="10">
                <Grid ColumnDefinitions="*, Auto">

                    <VerticalStackLayout Grid.Column="0"
                                         VerticalOptions="End"
                                         Padding="10">
                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label x:Name="DownloadSpeed"
                                   HorizontalTextAlignment="End"
                                   Grid.Column="1"
                                   Text="zzz..."
                                   FontFamily="MontserratLight"/>
                        </Grid>
                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label x:Name="TaskName"
                                   Grid.Column="0"
                                   Text="Чего смотришь, иди игру играть..."
                                   FontFamily="MontserratLight"
                                   LineBreakMode="NoWrap"/>
                            <Label x:Name="DownloadProgress"
                                   HorizontalTextAlignment="End"
                                   Grid.Column="1"
                                   Text="zzz..."
                                   FontFamily="MontserratLight"/>
                        </Grid>
                        <ProgressBar x:Name="LaunchProgressBar"
                                     ProgressColor="#EE4AEF"
                                     BackgroundColor="Gray"/>

                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1"
                                         WidthRequest="240"
                                         Spacing="7">

                        <local:PrimaryButton x:Name="LaunchButton"
                                             Text="Играть"
                                             HeightRequest="60"
                                             BackgroundColor="#6D208F"
                                             TextColor="White"
                                             FontFamily="MontserratBold"
                                             FontSize="22"
                                             Clicked="OnLaunchButtonClicked"/>
                    </VerticalStackLayout>
                </Grid>
            </StackLayout>
        </StackLayout>


        <Border
            InputTransparent="True"
            StrokeThickness="0"
            Grid.ColumnSpan="2"
            HeightRequest="100"
            VerticalOptions="Start">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="0,1">
                    <GradientStop Color="#5B000000"
                                  Offset="0.0"/>
                    <GradientStop Color="Transparent"
                                  Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>


    </Grid>

</ContentPage>