using System.ComponentModel;
using System.Runtime.CompilerServices;
using System.Windows.Input;

namespace launcher;

public class Modpack : INotifyPropertyChanged
{
    public string Name { get; set; }
    public string Icon { get; set; }
    private string _value;
    public string Value
    {
        get => _value;
        set
        {
            if (_value != value)
            {
                _value = value;
                Icon = $"{_value}_icon.png";
                OnPropertyChanged(nameof(Icon));
            }
        }
    }

    private bool _isSelected;
    public bool IsSelected
    {
        get => _isSelected;
        set
        {
            if (_isSelected != value)
            {
                _isSelected = value;
                OnPropertyChanged(nameof(IsSelected));
                OnPropertyChanged(nameof(BackgroundColor));
                OnPropertyChanged(nameof(SelectionAndHoverState));
            }
        }
    }
    public Color BackgroundColor => !IsEnabled? Color.FromRgb(0x22, 0x22, 0x22) : IsSelected? Color.FromRgb(0x6D, 0x20, 0x8F) : Color.FromRgb(0x20, 0x1E, 0x24);

    private bool _isHovered;
    private bool IsHovered
    {
        get => _isHovered;
        set
        {
            if (_isHovered != value)
            {
                _isHovered = value;
                OnPropertyChanged(nameof(IsHovered));
                OnPropertyChanged(nameof(SelectionAndHoverState));
            }
        }
    }
    public Tuple<bool, bool> SelectionAndHoverState => new (IsSelected, IsHovered);

    private bool _isLastItem;

    public bool IsLastItem
    {
        get => _isLastItem;
        set
        {
            if (_isLastItem != value)
            {
                _isLastItem = value;
                OnPropertyChanged(nameof(IsLastItem));
            }
        }
    }

    private bool _isEnabled = true;
    public bool IsEnabled
    {
        get => _isEnabled;
        set
        {
            if (_isEnabled != value)
            {
                 _isEnabled = value;
                OnPropertyChanged();
            }
        }
    }

    public ICommand PointerEnteredCommand => new Command(() =>
    {
        IsHovered = true;
    });

    public ICommand PointerExitedCommand => new Command(() =>
    {
        IsHovered = false;
    });


    public event PropertyChangedEventHandler PropertyChanged;

    protected void OnPropertyChanged([CallerMemberName] string propertyName = null)
    {
        PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(propertyName));
    }
}