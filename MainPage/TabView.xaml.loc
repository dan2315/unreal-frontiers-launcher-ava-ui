<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="launcher.TabView"
             x:Name="ThisTabView">

    <ContentView.Content>
        <Border StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,5,5"
                HorizontalOptions="Center"
                WidthRequest="130"
                BackgroundColor="{Binding TabBackgroundColor, Source={x:Reference ThisTabView}}">

            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OnTabSelectedCommand}"
                                      CommandParameter="{Binding CommandParameter, Source={x:Reference ThisTabView}}"/>
                <PointerGestureRecognizer
                    PointerEnteredCommand="{Binding OnTabHoveredCommand}"
                    PointerEnteredCommandParameter="{Binding CommandParameter, Source={x:Reference ThisTabView}}"
                    PointerExitedCommand="{Binding OnTabUnhoveredCommand}"
                    PointerExitedCommandParameter="{Binding CommandParameter, Source={x:Reference ThisTabView}}"/>
            </Border.GestureRecognizers>

            <VerticalStackLayout VerticalOptions="Center"
                                 Spacing="7">
                <Image Source="{Binding Icon, Source={x:Reference ThisTabView}}"
                       WidthRequest="32"
                       HeightRequest="32"/>
                <Label Text="{Binding Text, Source={x:Reference ThisTabView}}"
                       FontSize="16"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="White"
                       FontFamily="MontserratBold"/>
            </VerticalStackLayout>
        </Border>
    </ContentView.Content>
</ContentView>
