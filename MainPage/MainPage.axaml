<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:UnrealFrontiersLauncher.ViewModels"
        x:Class="UnrealFrontiersLauncher.MainPage"
        x:DataType="local:MainPageViewModel">

    <UserControl.Styles>
        <!-- Server cards -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Grid>
    <Grid ColumnDefinitions="320,*">
        <!-- Full-bleed background with readability overlay -->
        <Image Source="/Assets/Images/background_image.png"
               Stretch="UniformToFill"
               Grid.ColumnSpan="2" />
        <Border Grid.ColumnSpan="2" Opacity="0.72">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#0C0B0E" Offset="0.0" />
                    <GradientStop Color="#14121A" Offset="0.45" />
                    <GradientStop Color="#0C0B0E" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- ============ Left: servers + global settings + profile ============ -->
        <Grid Grid.Column="0">
            <Border BorderBrush="#26242C" BorderThickness="0,0,1,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                        <GradientStop Color="#121116" Offset="0.0" />
                        <GradientStop Color="#1C1A21" Offset="0.5" />
                        <GradientStop Color="#121116" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
                <!-- Servers header -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,16,12,4">
                    <TextBlock Grid.Column="0" Text="Servers"
                               FontSize="22"
                               Foreground="White"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource MontserratBold}" />
                    <Button Grid.Column="1"
                            Classes="uf-ghost"
                            Width="34" Height="34"
                            Click="OnRefreshModpacksClicked"
                            ToolTip.Tip="Refresh the modpack list">
                        <Svg Path="/Assets/Images/svg/refresh.svg" Width="18" Height="18"/>
                    </Button>
                </Grid>

                <Border Grid.Row="1"
                        Margin="12,4,12,0"
                        Padding="10,8"
                        CornerRadius="10"
                        Background="#2A2118"
                        BorderBrush="#E8B83A" BorderThickness="1"
                        IsVisible="{Binding HasCatalogMessage}">
                    <TextBlock Text="{Binding CatalogMessage}"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="#E8B83A"
                               FontFamily="{StaticResource MontserratRegular}" />
                </Border>

                <!-- Server cards -->
                <ScrollViewer Grid.Row="2" Margin="8,4,8,4"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="ModpackCollectionView"
                             ItemsSource="{Binding Modpacks}"
                             SelectedItem="{Binding SelectedModpack}"
                             SelectionChanged="OnInstanceSelected"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding CardBackground}"
                                        BorderBrush="{Binding CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="12,10"
                                        Margin="4,2"
                                        PointerEntered="Modpack_OnPointerEntered"
                                        PointerExited="Modpack_OnPointerExited">
                                    <!-- NB: hover fade transitions are applied at
                                         runtime via UiAnimations.ApplyCardTransitions,
                                         so the master switch can kill them. -->
                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*">
                                        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                                Width="40" Height="40" CornerRadius="10"
                                                ClipToBounds="True" Margin="0,0,12,0"
                                                Background="#141218">
                                            <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontSize="14" TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding TextColor}"
                                                   FontFamily="{StaticResource MontserratBold}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                   Text="{Binding Subtitle}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="#8E939B"
                                                   FontFamily="{StaticResource MontserratRegular}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <!-- Global settings button -->
                <Button Grid.Row="3" Classes="uf-side" Margin="12,4,12,4"
                        Click="OnGlobalSettingsClicked"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="8"
                                Background="{StaticResource UfAccentGradient}">
                            <Svg Path="/Assets/Images/svg/gear.svg" Width="18" Height="18"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="LAUNCHER" Classes="uf-caption"
                                       FontFamily="{StaticResource MontserratRegular}"/>
                            <TextBlock Text="Настройки"
                                       FontFamily="{StaticResource MontserratBold}"
                                       FontSize="14" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- Profile button, pinned at the bottom -->
                <Button Grid.Row="4" x:Name="ProfileButton" Classes="uf-side" Margin="12,0,12,12"
                        Click="OnProfileClicked"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="8" ClipToBounds="True" Background="#141218">
                            <Image Source="/Assets/Images/stevehead.png" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PLAYER" Classes="uf-caption"
                                       FontFamily="{StaticResource MontserratRegular}"/>
                            <TextBlock Text="{Binding PlayerName}"
                                       FontFamily="{StaticResource MontserratBold}"
                                       FontSize="14" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
                </Grid>
            </Border>

            <!-- Profile popup: floats above the sidebar bottom, never shifts layout.
                 Transparent catcher closes it on outside click. -->
            <Grid x:Name="ProfilePopup" IsVisible="False">
                <Border Background="Transparent" PointerPressed="OnProfileOverlayPressed"/>
                <Border Classes="uf-card" Margin="12,0,12,64" Padding="12"
                        HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="44" Height="44" CornerRadius="10" ClipToBounds="True" Background="#141218">
                                <Image Source="/Assets/Images/stevehead.png" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Вы вошли как" Classes="uf-caption" FontFamily="{StaticResource MontserratBold}"/>
                                <TextBlock Text="{Binding PlayerName}"
                                           FontFamily="{StaticResource MontserratBold}"
                                           FontSize="16" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Classes="uf-card" Click="OnAddPasswordClicked"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <Svg Path="/Assets/Images/svg/lock.svg" Height="16" Width="16"/>
                                <TextBlock FontFamily="{StaticResource MontserratBold}"
                                           FontSize="13" Foreground="White"
                                           Text="Добавить пароль" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OnConnectDiscordClicked"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Background="#5865F2" Foreground="White"
                                BorderThickness="0" CornerRadius="10" Padding="12,8" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <Svg Path="/Assets/Images/svg/discord.svg" Height="16" Width="16"/>
                                <TextBlock FontFamily="{StaticResource MontserratBold}"
                                           FontSize="13"
                                           Text="Подключить Discord" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="uf-card" Click="OnLogoutClicked"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <Svg Path="/Assets/Images/svg/logout.svg" Height="16" Width="16"/>
                                <TextBlock FontFamily="{StaticResource MontserratBold}"
                                           FontSize="13" Foreground="#E5484D"
                                           Text="Выйти" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ Right: modpack hero + RAM panel + news + launch ============ -->
        <Grid Grid.Column="1" RowDefinitions="*,Auto" Margin="20,12,20,12">
            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14" Margin="0,2,0,0">
                    <!-- Single modpack hero card -->
                    <Border Classes="uf-card" Padding="0" ClipToBounds="True">
                        <StackPanel>
                            <Image Source="{StaticResource UfLogoBanner}"
                                   Stretch="Uniform" HorizontalAlignment="Center"
                                   MaxHeight="110" Margin="24,16,24,0"/>
                            <Border Height="1" Background="#2E2C34" Margin="20,12,20,0"/>
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,12,20,16">
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12"
                                        ClipToBounds="True" Background="#141218" Margin="0,0,12,0">
                                    <Image Source="{Binding SelectedModpack.Icon}" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding SelectedModpack.Name}"
                                               FontFamily="{StaticResource MontserratBold}"
                                               FontSize="22" Foreground="White"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8"
                                                 Fill="{Binding SelectedModpack.StatusColor}"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedModpack.StatusText}"
                                                   FontFamily="{StaticResource MontserratRegular}"
                                                   FontSize="12" Foreground="{Binding SelectedModpack.StatusColor}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="·" FontSize="12" Foreground="#5E6068" VerticalAlignment="Center"/>
                                        <TextBlock Text="Онлайн:" FontSize="12" Foreground="#8E939B"
                                                   FontFamily="{StaticResource MontserratRegular}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedModpack.PlayerCount}"
                                                   FontFamily="{StaticResource MontserratBold}"
                                                   FontSize="12" Foreground="{Binding SelectedModpack.PlayerCountColor}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="·" FontSize="12" Foreground="#5E6068" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedModpack.Subtitle}"
                                                   FontFamily="{StaticResource MontserratRegular}"
                                                   FontSize="12" Foreground="#5E6068"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <ProgressBar Classes="uf-thin" Value="{Binding SelectedModpack.PlayerCountProgress}"
                                                 Margin="0,6,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Classes="uf-ghost" Click="OnModpackSettingsClicked"
                                        Width="40" Height="40" VerticalAlignment="Center"
                                        ToolTip.Tip="Настройки сборки">
                                    <Svg Path="/Assets/Images/svg/gear.svg" Width="20" Height="20"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- News -->
                    <Border Classes="uf-card" Padding="0" ClipToBounds="True">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="20,16,20,0">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Новости проекта" FontFamily="{StaticResource MontserratBold}" FontSize="16" Foreground="White"/>
                                    <Border Height="2" Width="64" CornerRadius="1"
                                            HorizontalAlignment="Left"
                                            Background="{StaticResource UfAccentGradient}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="uf-ghost" Click="OnShowFullChangelogClicked"
                                        Padding="10,6" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="Все изменения" FontFamily="{StaticResource MontserratBold}"
                                               FontSize="12" Foreground="{StaticResource UfMintBrush}"/>
                                </Button>
                            </Grid>
                            <StackPanel Spacing="0" Margin="20,12,20,18">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,6">
                                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Margin="0,5,10,0"
                                            Background="{StaticResource UfMintBrush}"/>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Настройки сборки и лаунчера — прямо в приложении"
                                                   FontFamily="{StaticResource MontserratBold}"
                                                   FontSize="13" Foreground="White" TextWrapping="Wrap"/>
                                        <TextBlock Text="Всплывающее окно с затемнением, RAM с шагом по степеням двойки"
                                                   FontFamily="{StaticResource MontserratRegular}"
                                                   FontSize="12" Foreground="#8E939B" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="12 окт" Margin="12,0,0,0"
                                               FontFamily="{StaticResource MontserratRegular}"
                                               FontSize="11" Foreground="#5E6068" VerticalAlignment="Top"/>
                                </Grid>
                                <Border Height="1" Background="#2E2C34" Margin="8,6"/>
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,6">
                                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Margin="0,5,10,0"
                                            Background="{StaticResource UfMintBrush}"/>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Редизайн в стилистике Reborn"
                                                   FontFamily="{StaticResource MontserratBold}"
                                                   FontSize="13" Foreground="White" TextWrapping="Wrap"/>
                                        <TextBlock Text="Тёмная тема, mint-акцент, новый логотип"
                                                   FontFamily="{StaticResource MontserratRegular}"
                                                   FontSize="12" Foreground="#8E939B" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="12 окт" Margin="12,0,0,0"
                                               FontFamily="{StaticResource MontserratRegular}"
                                               FontSize="11" Foreground="#5E6068" VerticalAlignment="Top"/>
                                </Grid>
                                <Border Height="1" Background="#2E2C34" Margin="8,6"/>
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,6">
                                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Margin="0,5,10,0"
                                            Background="{StaticResource UfMintBrush}"/>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Динамический каталог сборок"
                                                   FontFamily="{StaticResource MontserratBold}"
                                                   FontSize="13" Foreground="White" TextWrapping="Wrap"/>
                                        <TextBlock Text="Список серверов с бэкенда, кэш при недоступности"
                                                   FontFamily="{StaticResource MontserratRegular}"
                                                   FontSize="12" Foreground="#8E939B" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="11 окт" Margin="12,0,0,0"
                                               FontFamily="{StaticResource MontserratRegular}"
                                               FontSize="11" Foreground="#5E6068" VerticalAlignment="Top"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Height="8" Opacity="0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom launch panel -->
            <Border Grid.Row="1" Classes="uf-card" Padding="16,12" Margin="0,12,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       x:Name="TaskName"
                                       Text="Чего смотришь, иди игру играть..."
                                       FontFamily="{StaticResource MontserratRegular}"
                                       FontSize="13" Foreground="#B9BDC2"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="12,0,0,0">
                                <TextBlock x:Name="DownloadSpeed"
                                           Text="—"
                                           FontFamily="{StaticResource MontserratRegular}"
                                           FontSize="12" Foreground="#8E939B"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="DownloadProgress"
                                           Text=""
                                           FontFamily="{StaticResource MontserratBold}"
                                           FontSize="12" Foreground="{StaticResource UfMintBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <ProgressBar x:Name="LaunchProgressBar" Classes="uf-bar" Value="0"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="LaunchButton"
                            Classes="uf-launch" Click="OnLaunchButtonClicked"
                            Content="Играть!"
                            FontFamily="{StaticResource MontserratBold}"
                            FontSize="22" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <!-- NB: breathing animation + mint glow are applied at
                         runtime via UiAnimations.ApplyLaunchStyle, so the
                         "Свечение кнопки" switch can kill them. -->
                </Grid>
            </Border>
        </Grid>
    </Grid>

        <!-- Settings overlay: dimmed backdrop + centered panel.
             Starts transparent; code-behind fades it in as one piece so the
             open never flashes (see ShowSettingsOverlay). -->
        <Grid x:Name="SettingsOverlay" IsVisible="False" Opacity="0">
            <Border x:Name="SettingsOverlayBackdrop" Background="#B3000000" PointerPressed="OnOverlayBackdropPressed"/>
            <ContentControl x:Name="SettingsOverlayContent"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
