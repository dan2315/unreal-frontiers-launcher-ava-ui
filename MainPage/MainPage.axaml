<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:UnrealFrontiersLauncher.ViewModels"
        xmlns:converters="using:UnrealFrontiersLauncher.Converters"
        x:Class="UnrealFrontiersLauncher.MainPage"
        x:DataType="local:MainPageViewModel">

    <UserControl.Resources>
        <converters:MultiConditionColorConverter x:Key="MultiConditionColorConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Tab headers: underline accent for the active tab -->
        <Style Selector="TabItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="TabItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="10,10,0,0" />
        </Style>
        <Style Selector="TabItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#221F28" />
        </Style>
        <Style Selector="TabItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#1E1B23" />
        </Style>
        <Style Selector="TabItem TextBlock.tab-title">
            <Setter Property="Foreground" Value="#9AA0A8" />
        </Style>
        <Style Selector="TabItem:selected TextBlock.tab-title">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TabItem:pointerover TextBlock.tab-title">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TabItem Border.tab-underline">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TabItem:selected Border.tab-underline">
            <Setter Property="Background" Value="{StaticResource UfAccentGradient}" />
        </Style>

        <!-- Server cards -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="320,*">
        <!-- Full-bleed background with readability overlay -->
        <Image Source="/Assets/Images/background_image.png"
               Stretch="UniformToFill"
               Grid.ColumnSpan="2" />
        <Border Grid.ColumnSpan="2" Opacity="0.72">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#0C0B0E" Offset="0.0" />
                    <GradientStop Color="#14121A" Offset="0.45" />
                    <GradientStop Color="#0C0B0E" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- ============ Left: servers ============ -->
        <Border Grid.Column="0"
                BorderBrush="#26242C" BorderThickness="0,0,1,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                    <GradientStop Color="#121116" Offset="0.0" />
                    <GradientStop Color="#1C1A21" Offset="0.5" />
                    <GradientStop Color="#121116" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                <!-- Brand -->
                <StackPanel Grid.Row="0" Margin="16,16,16,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Width="3" Height="26" CornerRadius="2"
                                Background="{StaticResource UfAccentGradient}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="UNREAL FRONTIERS"
                                       FontFamily="{StaticResource MontserratBold}"
                                       FontSize="13" Foreground="White" LetterSpacing="1"/>
                            <TextBlock Text="SERVER LIST"
                                       FontFamily="{StaticResource MontserratRegular}"
                                       FontSize="10" Foreground="#7C828A" LetterSpacing="3"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Servers header -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="16,8,12,4">
                    <TextBlock Grid.Column="0" Text="Servers"
                               FontSize="22"
                               Foreground="White"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource MontserratBold}" />
                    <Button Grid.Column="1"
                            Classes="uf-ghost"
                            Width="34" Height="34"
                            Click="OnRefreshModpacksClicked"
                            ToolTip.Tip="Refresh the modpack list">
                        <Svg Path="/Assets/Images/svg/refresh.svg" Width="18" Height="18"/>
                    </Button>
                </Grid>

                <Border Grid.Row="2"
                        Margin="12,4,12,0"
                        Padding="10,8"
                        CornerRadius="10"
                        Background="#2A2118"
                        BorderBrush="#E8B83A" BorderThickness="1"
                        IsVisible="{Binding HasCatalogMessage}">
                    <TextBlock Text="{Binding CatalogMessage}"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="#E8B83A"
                               FontFamily="{StaticResource MontserratRegular}" />
                </Border>

                <!-- Server cards -->
                <ScrollViewer Grid.Row="3" Margin="8,4,8,4"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="ModpackCollectionView"
                             ItemsSource="{Binding Modpacks}"
                             SelectedItem="{Binding SelectedModpack}"
                             SelectionChanged="OnInstanceSelected"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding CardBackground}"
                                        BorderBrush="{Binding CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="12,10"
                                        Margin="4,2"
                                        PointerEntered="Modpack_OnPointerEntered"
                                        PointerExited="Modpack_OnPointerExited">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*">
                                        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                                Width="40" Height="40" CornerRadius="10"
                                                ClipToBounds="True" Margin="0,0,12,0"
                                                Background="#141218">
                                            <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontSize="14" TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding TextColor}"
                                                   FontFamily="{StaticResource MontserratBold}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                   Text="{Binding Subtitle}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="#8E939B"
                                                   FontFamily="{StaticResource MontserratRegular}"/>
                                        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                              ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
                                            <Ellipse Grid.Column="0" Width="8" Height="8"
                                                     Fill="{Binding StatusColor}"
                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding StatusText}"
                                                       FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Foreground="{Binding StatusColor}"
                                                       FontFamily="{StaticResource MontserratBold}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding PlayerCount}"
                                                       FontSize="11"
                                                       Foreground="#B9BDC2"
                                                       FontFamily="{StaticResource MontserratRegular}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>
                                        <ProgressBar Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                                     Classes="uf-thin"
                                                     Value="{Binding PlayerCountProgress}"
                                                     Margin="0,6,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <!-- Player chip -->
                <Border Grid.Row="4" Classes="uf-card" Margin="12" Padding="10">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="8" ClipToBounds="True" Background="#141218">
                            <Image Source="/Assets/Images/stevehead.png" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PLAYER" Classes="uf-caption"
                                       FontFamily="{StaticResource MontserratRegular}"/>
                            <TextBlock Text="{Binding PlayerName}"
                                       FontFamily="{StaticResource MontserratBold}"
                                       FontSize="14" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============ Right: tabs + launch ============ -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="20,12,20,12">
            <!-- Tabs -->
            <TabControl Grid.Row="0" Grid.RowSpan="2" Background="Transparent" BorderThickness="0">
                <!-- Play -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Spacing="2" MinWidth="120">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <Svg Path="/Assets/Images/svg/tab_play.svg" Width="18" Height="18"/>
                                <TextBlock Classes="tab-title" FontFamily="{StaticResource MontserratBold}" FontSize="15" Text="Играть!" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Classes="tab-underline" Height="2" CornerRadius="1"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14" Margin="0,14,0,0">
                            <!-- Hero banner -->
                            <Border Classes="uf-card" Padding="0" ClipToBounds="True">
                                <StackPanel>
                                    <Image Source="{StaticResource UfLogoBanner}"
                                           Stretch="Uniform" HorizontalAlignment="Center"
                                           MaxHeight="110" Margin="24,16,24,0"/>
                                    <Border Height="1" Background="#2E2C34" Margin="20,12,20,0"/>
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="20,12,20,16" VerticalAlignment="Center">
                                        <Border Width="44" Height="44" CornerRadius="12" ClipToBounds="True" Background="#141218">
                                            <Image Source="{Binding SelectedModpack.Icon}" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="{Binding SelectedModpack.Name}"
                                                   FontFamily="{StaticResource MontserratBold}"
                                                   FontSize="22" Foreground="White"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Server facts -->
                            <Grid ColumnDefinitions="*,*,*">
                                <Border Grid.Column="0" Classes="uf-card" Padding="16,14" Margin="0,0,6,0" MinHeight="108">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="ОНЛАЙН" Classes="uf-caption" FontFamily="{StaticResource MontserratBold}"/>
                                        <TextBlock Text="{Binding SelectedModpack.PlayerCount}"
                                                   FontFamily="{StaticResource MontserratBold}"
                                                   FontSize="20" Foreground="{StaticResource UfMintBrush}"/>
                                        <ProgressBar Classes="uf-bar" Value="{Binding SelectedModpack.PlayerCountProgress}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Classes="uf-card" Padding="16,14" Margin="6,0,6,0" MinHeight="108">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="СБОРКА" Classes="uf-caption" FontFamily="{StaticResource MontserratBold}"/>
                                        <TextBlock Text="{Binding SelectedModpack.Subtitle}"
                                                   FontFamily="{StaticResource MontserratBold}" TextWrapping="Wrap"
                                                   FontSize="15" Foreground="White"/>
                                        <TextBlock Text="{Binding SelectedModpack.StatusText}"
                                                   FontFamily="{StaticResource MontserratRegular}"
                                                   FontSize="12" Foreground="{Binding SelectedModpack.StatusColor}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Classes="uf-card" Padding="16,14" Margin="6,0,0,0" MinHeight="108">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="ФАЙЛЫ ИГРЫ" Classes="uf-caption" FontFamily="{StaticResource MontserratBold}"/>
                                        <Button Classes="uf-card" Click="OnShowFolderClicked" HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <Svg Path="/Assets/Images/svg/folder.svg" Height="18" Width="18"/>
                                                <TextBlock FontFamily="{StaticResource MontserratBold}"
                                                           FontSize="13" Foreground="White"
                                                           Text="Папка instance" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- News placeholder -->
                            <Border Classes="uf-card" Padding="20,18">
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <Image Source="../Assets/Images/roflanbuldiga.png" Width="72" Height="72" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="Новости проекта" FontFamily="{StaticResource MontserratBold}" FontSize="16" Foreground="White"/>
                                        <TextBlock Text="Здесь могла быть ваша реклама, но есть только: «Продам гараж недорого, звонить → 8 (800) 555-35-35»"
                                                   FontFamily="{StaticResource MontserratRegular}"
                                                   FontSize="14" Foreground="#B9BDC2" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Height="8" Opacity="0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Settings -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Spacing="2" MinWidth="120">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <Svg Path="/Assets/Images/svg/tab_settings.svg" Width="18" Height="18"/>
                                <TextBlock Classes="tab-title" FontFamily="{StaticResource MontserratBold}" FontSize="15" Text="Настройки" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Classes="tab-underline" Height="2" CornerRadius="1"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14" Margin="0,14,0,0">
                            <!-- Memory allocation hero card -->
                            <Border Classes="uf-card" Padding="20,18">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Border Width="40" Height="40" CornerRadius="12"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource UfAccentGradient}">
                                            <Svg Path="/Assets/Images/svg/ram.svg" Width="22" Height="22"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Spacing="0" VerticalAlignment="Center">
                                            <TextBlock Text="Память для игры"
                                                       FontSize="16"
                                                       FontFamily="{StaticResource MontserratBold}"
                                                       Foreground="White"/>
                                            <TextBlock Text="Сколько RAM получит выбранный сервер"
                                                       FontSize="12"
                                                       FontFamily="{StaticResource MontserratRegular}"
                                                       Foreground="#8E939B"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock x:Name="RamValueLabel" Text="—"
                                                       FontFamily="{StaticResource MontserratBold}"
                                                       FontSize="34" Foreground="White"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="MB"
                                                       FontFamily="{StaticResource MontserratBold}"
                                                       FontSize="15" Foreground="{StaticResource UfMintBrush}"
                                                       VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="Указать вручную:"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource MontserratRegular}"
                                                       FontSize="12" Foreground="#8E939B"/>
                                            <TextBox x:Name="RamEntry" Classes="uf-field"
                                                     Width="100" Padding="8,6" FontSize="13"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Height="28" VerticalAlignment="Center">
                                        <Border x:Name="RamBase" Height="8" CornerRadius="4" Background="#333036" VerticalAlignment="Center"/>
                                        <Border x:Name="RamFill" Height="8" CornerRadius="4"
                                                HorizontalAlignment="Left" VerticalAlignment="Center" Width="0"
                                                Background="{StaticResource UfAccentGradient}"/>
                                        <Slider x:Name="RamSlider"
                                                Theme="{StaticResource UfRamSlider}"
                                                VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0" Text="1 ГБ"
                                                   FontFamily="{StaticResource MontserratRegular}"
                                                   FontSize="11" Foreground="#5E6068"/>
                                        <TextBlock Grid.Column="1" x:Name="RamMaxLabel" Text="—"
                                                   HorizontalAlignment="Right"
                                                   FontFamily="{StaticResource MontserratRegular}"
                                                   FontSize="11" Foreground="#5E6068"/>
                                    </Grid>

                                </StackPanel>
                            </Border>

                            <!-- Behaviour toggles -->
                            <Border Classes="uf-card" Padding="0">
                                <StackPanel>
                                    <TextBlock Text="Поведение запуска"
                                               FontSize="16"
                                               FontFamily="{StaticResource MontserratBold}"
                                               Foreground="White"
                                               Margin="20,16,20,4"/>
                                    <TextBlock Text="Мелочи, которые делают запуск удобнее"
                                               FontSize="12"
                                               FontFamily="{StaticResource MontserratRegular}"
                                               Foreground="#8E939B"
                                               Margin="20,0,20,12"/>
                                    <Border Height="1" Background="#2E2C34"/>

                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,12,20,8">
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12"
                                                VerticalAlignment="Center" Background="#26232C" Margin="0,0,12,0">
                                            <Svg Path="/Assets/Images/svg/console.svg" Width="22" Height="22"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Открыть консоль"
                                                       FontFamily="{StaticResource MontserratBold}"
                                                       Foreground="White" FontSize="14"/>
                                            <TextBlock Text="Показывать окно логов игры при запуске"
                                                       FontFamily="{StaticResource MontserratRegular}"
                                                       Foreground="#8E939B" FontSize="12"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="2" x:Name="OpenConsoleBox"
                                                      Theme="{StaticResource UfSettingsToggle}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Border Height="1" Background="#2E2C34" Margin="20,8,20,0"/>

                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,12,20,16">
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12"
                                                VerticalAlignment="Center" Background="#26232C" Margin="0,0,12,0">
                                            <Svg Path="/Assets/Images/svg/power.svg" Width="22" Height="22"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Закрыть лаунчер при запуске"
                                                       FontFamily="{StaticResource MontserratBold}"
                                                       Foreground="White" FontSize="14"/>
                                            <TextBlock Text="Освобождает память во время игры"
                                                       FontFamily="{StaticResource MontserratRegular}"
                                                       Foreground="#8E939B" FontSize="12"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="2" x:Name="CloseLauncherBox"
                                                      Theme="{StaticResource UfSettingsToggle}" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Profile -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Spacing="2" MinWidth="120">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <Svg Path="/Assets/Images/svg/tab_profile.svg" Width="18" Height="18"/>
                                <TextBlock Classes="tab-title" FontFamily="{StaticResource MontserratBold}" FontSize="15" Text="Профиль" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Classes="tab-underline" Height="2" CornerRadius="1"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14" Margin="0,14,0,0">
                            <Border Classes="uf-card" Padding="20">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <Border Width="64" Height="64" CornerRadius="14" ClipToBounds="True" Background="#141218">
                                        <Image Source="/Assets/Images/stevehead.png" Stretch="UniformToFill"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Вы вошли как" Classes="uf-caption" FontFamily="{StaticResource MontserratBold}"/>
                                        <TextBlock Text="{Binding PlayerName}"
                                                   FontFamily="{StaticResource MontserratBold}"
                                                   FontSize="22" Foreground="White"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Classes="uf-card" Padding="20">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Безопасность и связи" FontFamily="{StaticResource MontserratBold}" FontSize="15" Foreground="White"/>
                                    <Button Classes="uf-card" x:Name="AddPasswordButton"
                                            HorizontalAlignment="Left" MinWidth="280" MaxWidth="400"
                                            HorizontalContentAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                            <Svg Path="../Assets/Images/svg/lock.svg" Height="18" Width="18"/>
                                            <TextBlock FontFamily="{StaticResource MontserratBold}"
                                                       FontSize="14" Foreground="White"
                                                       Text="Добавить пароль" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ConnectDiscordButton"
                                            HorizontalAlignment="Left" MinWidth="280" MaxWidth="400"
                                            HorizontalContentAlignment="Center"
                                            Background="#5865F2" Foreground="White"
                                            BorderThickness="0" CornerRadius="10" Padding="14,10" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                            <Svg Path="../Assets/Images/svg/discord.svg" Height="18" Width="18"/>
                                            <TextBlock FontFamily="{StaticResource MontserratBold}"
                                                       FontSize="14"
                                                       Text="Подключить Discord" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Bottom launch panel -->
            <Border Grid.Row="2" Classes="uf-card" Padding="16,12" Margin="0,12,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       x:Name="TaskName"
                                       Text="Чего смотришь, иди игру играть..."
                                       FontFamily="{StaticResource MontserratRegular}"
                                       FontSize="13" Foreground="#B9BDC2"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="12,0,0,0">
                                <TextBlock x:Name="DownloadSpeed"
                                           Text="—"
                                           FontFamily="{StaticResource MontserratRegular}"
                                           FontSize="12" Foreground="#8E939B"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="DownloadProgress"
                                           Text=""
                                           FontFamily="{StaticResource MontserratBold}"
                                           FontSize="12" Foreground="{StaticResource UfMintBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <ProgressBar x:Name="LaunchProgressBar" Classes="uf-bar" Value="0"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="LaunchButton"
                            Classes="uf-primary" Click="OnLaunchButtonClicked"
                            Content="Играть!"
                            Foreground="White" FontFamily="{StaticResource MontserratBold}"
                            FontSize="22" Padding="44,10" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button.Styles>
                            <Style Selector="Button.uf-primary">
                                <Style.Animations>
                                    <Animation Duration="0:0:5" PlaybackDirection="AlternateReverse" IterationCount="INFINITE">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="Background" Value="{StaticResource UfLaunchGradient}"/>
                                        </KeyFrame>
                                        <KeyFrame Cue="100%">
                                            <Setter Property="Background" Value="{StaticResource UfLaunchHoverGradient}"/>
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </Button.Styles>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
