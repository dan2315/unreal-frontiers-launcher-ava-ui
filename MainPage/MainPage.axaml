<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:UnrealFrontiersLauncher.ViewModels"
        xmlns:converters="using:UnrealFrontiersLauncher.Converters"
        x:Class="UnrealFrontiersLauncher.MainPage"
        x:DataType="local:MainPageViewModel">

    <UserControl.Resources>
        <converters:MultiConditionColorConverter x:Key="MultiConditionColorConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Background Image -->
        <Image Source="/Assets/Images/background_image.png"
           Stretch="UniformToFill"
           Grid.ColumnSpan="2" />

        
        <!-- Left Side Panel -->
        <StackPanel Grid.Column="0"
                    Width="280">
            <StackPanel.Background>
                <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                    <GradientStop Color="#100F12" Offset="0.0"></GradientStop>
                    <GradientStop Color="#2A272F" Offset="0.5"></GradientStop>
                    <GradientStop Color="#100F12" Offset="1.0"></GradientStop>
                </LinearGradientBrush>
            </StackPanel.Background>
            <TextBlock Text="Servers"
                       TextAlignment="Center"
                       FontSize="34"
                       Foreground="White"
                       Margin="0,15,0,20"
                       FontFamily="{StaticResource MontserratBold}" />

            <!-- Modpack Collection -->
            <ListBox x:Name="ModpackCollectionView"
                              ItemsSource="{Binding Modpacks}"
                              SelectedItem="{Binding SelectedModpack}"
                              SelectionChanged="OnInstanceSelected" Background="Transparent"
                              BorderBrush="Transparent">
                
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Background="Transparent">
                            <Border Background="{Binding BackgroundColor}"
                                    Margin="0,10,0,10"
                                    Padding="5"
                                    CornerRadius="10"
                                    PointerEntered="Modpack_OnPointerEntered"
                                    PointerExited="Modpack_OnPointerExited"
                                    Height="75"
                                    MaxWidth="250">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Image Source="{Binding Icon}"
                                               Width="30"
                                               Height="30"
                                               Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="16" VerticalAlignment="Center"
                                                   Foreground="{Binding TextColor}"
                                                   FontFamily="{StaticResource MontserratLight}"
                                                   MaxWidth="250">
                                        </TextBlock>
                                    </StackPanel>
                                    <!-- Player Count -->
                                    <StackPanel Margin="0,8,0,0" MaxWidth="200">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding PlayerCount}"
                                                       FontSize="12"
                                                       Foreground="#D0D0D0"
                                                       FontFamily="{StaticResource MontserratLight}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding MaxPlayers}"
                                                       FontSize="12"
                                                       Foreground="#D0D0D0"
                                                       FontFamily="{StaticResource MontserratLight}"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding PlayerCountProgress}"
                                                     MinHeight="4"
                                                     MinWidth="130"
                                                     Background="#404040"
                                                     Foreground="#22AA22">
                                            <!-- <ProgressBar.></ProgressBar.> -->
                                        </ProgressBar>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
            
                            <!-- Divider Line -->
                            <Rectangle Height="1"
                                       Fill="#404040"
                                       HorizontalAlignment="Stretch"
                                       IsVisible="{Binding IsLastItem}"
                                       MaxWidth="200"/>
                        </StackPanel>
                    </DataTemplate>
            
                </ListBox.ItemTemplate>
            
                <ListBox.Styles>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Foreground" Value="White"></Setter>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Opacity" Value="75"></Setter>
                    </Style>
            
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Foreground" Value="White"></Setter>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="VerticalAlignment" Value="Bottom"></Setter>
                    </Style>
                </ListBox.Styles>
            </ListBox>

                
        </StackPanel>

        <!-- Right Side Panel --> 
        <DockPanel Grid.Column="1">
            <Grid ColumnDefinitions="*, 250" RowDefinitions="*, Auto" DockPanel.Dock="Top">
                <!-- Tab Content -->
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Stretch"
                            Orientation="Horizontal">
                    <TabControl Margin="10 -10 10 0">
                        <TabItem Margin="0 0 10 0" CornerRadius="0 0 5 5" Width="125">
                            
                            <TabItem.Header>
                                <StackPanel>
                                    <Image Source="../Assets/Images/sword.png" Width="30" Height="30" Margin="18 0 0 0"></Image>
                                    <TextBlock Margin="18 0 0 0" Foreground="White" FontFamily="{StaticResource MontserratBold}" FontSize="18" Text="Играть!"></TextBlock>
                                    <Rectangle Margin="18 0 0 0" Height="1" Fill="White" HorizontalAlignment="Stretch"></Rectangle>
                                </StackPanel>
                            </TabItem.Header>
                            
                            <TabItem.Styles>
                                <Style Selector="TabItem:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#8a58bb"/>
                                    <Setter Property="Opacity" Value="50"></Setter>
                                </Style>
                                
                                <Style Selector="TabItem:selected  /template/ ContentPresenter">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,50%" Opacity="75">
                                                <GradientStop Color="#8a58bb" Offset="0.2" />
                                                <GradientStop Color="#ee4aef" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                
                                <Style Selector="TabItem:selected:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#8a58bb"/>
                                    <Setter Property="Opacity" Value="50"></Setter>
                                </Style>
                            </TabItem.Styles>

                            <Grid ColumnDefinitions="*, 475" RowDefinitions="150, *">
                                <Border Background="#201E24"
                                        Margin="10 10 10 10"
                                        Width="600"
                                        CornerRadius="5"
                                        BorderBrush="Black"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel Margin="10">
                                            <Image Source="../Assets/Images/roflanbuldiga.png" Width="70" Height="70"/>
                                            <TextBlock TextAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource MontserratRegular}" FontSize="13">Roflan Buldiga</TextBlock>
                                        </StackPanel>
                                        
                                        <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource MontserratRegular}" FontSize="16">Здесь могла быть ваша реклама, но есть только: <LineBreak/> "Продам гараж недорого, звонить -> +8(800)-555-35-35"</TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>
                        
                        <TabItem Margin=" 0 0 10 0" CornerRadius="0 0 5 5" Width="125">
                            
                            <TabItem.Styles>
                                <Style Selector="TabItem:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#8a58bb"/>
                                    <Setter Property="Opacity" Value="50"></Setter>
                                </Style>
                                
                                <Style Selector="TabItem:selected  /template/ ContentPresenter">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,50%" Opacity="75">
                                                <GradientStop Color="#8a58bb" Offset="0.2" />
                                                <GradientStop Color="#ee4aef" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                
                                <Style Selector="TabItem:selected:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#8a58bb"/>
                                    <Setter Property="Opacity" Value="50"></Setter>
                                </Style>
                            </TabItem.Styles>
                            
                            <TabItem.Header>
                                <StackPanel>
                                    <Image Margin="3 0 0 0" Source="../Assets/Images/settings.png" Width="30" Height="30"></Image>
                                    <TextBlock Margin="0 0 0 0" Foreground="White" FontFamily="{StaticResource MontserratBold}" FontSize="18" Text="Настройки"></TextBlock>
                                    <Rectangle Margin="0 0 0 0" Height="1" Fill="White" IsVisible="{Binding}" HorizontalAlignment="Stretch"></Rectangle>
                                </StackPanel>
                            </TabItem.Header>
                            
                            <!-- Ебанина с настройками -->
                            <Border Grid.Column="0"
                                    Background="#201E24"
                                    Margin="10"
                                    CornerRadius="5"
                                    BorderBrush="Black"
                                    BorderThickness="1">
                                <StackPanel>

                                    <StackPanel>
                                        <Border Background="#1b191f" CornerRadius="5 5 0 0">
                                            <TextBlock Text="Настройки"
                                                       FontSize="18"
                                                       FontFamily="{StaticResource MontserratBold}"
                                                       Margin="10"
                                                       TextAlignment="Center"/>
                                        </Border>
                                        <Rectangle Height="1" Fill="Black"></Rectangle>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal"
                                                Background="#2f2d36"
                                                Spacing="15"
                                                Margin="0 10 0 10">
                                        <TextBlock Text="RAM:"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource MontserratBold}"
                                                Margin="5 0 0 0"/>
                                        <Slider x:Name="RamSlider"
                                                Width="400"
                                                VerticalAlignment="Center" />
                                        <TextBox x:Name="RamEntry"
                                                Width="140"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Margin="0 0 5 0"/>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal"
                                                Background="#2f2d36"
                                                Spacing="15">
                                        <TextBlock Text="Открыть консоль:"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource MontserratBold}"
                                                Margin="5 5 0 0"/>
                                        <CheckBox x:Name="OpenConsoleBox"
                                                  Margin="0 5 0 0"
                                                  CornerRadius="2"/>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal"
                                                Background="#2f2d36"
                                                Spacing="15">
                                        <TextBlock Text="Закрыть лаунчер при запуске:"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource MontserratBold}" 
                                                Margin="5 0 0 10"/>
                                        
                                        <CheckBox x:Name="CloseLauncherBox" 
                                                Margin="0 0 0 8"
                                                CornerRadius="2"/>
                                    </StackPanel>
                                    <Rectangle Height="1" Fill="Black"></Rectangle>
                                </StackPanel>
                            </Border>
                        </TabItem>
                        
                        <!-- Profile Tab -->
                        <TabItem Margin=" 0 0 10 0" CornerRadius="0 0 5 5" Width="125" >
                            
                            <TabItem.Styles>
                                <Style Selector="TabItem:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#8a58bb"/>
                                    <Setter Property="Opacity" Value="50"></Setter>
                                </Style>
                                
                                <Style Selector="TabItem:selected  /template/ ContentPresenter">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,50%" Opacity="75">
                                                <GradientStop Color="#8a58bb" Offset="0.2" />
                                                <GradientStop Color="#ee4aef" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                
                                <Style Selector="TabItem:selected:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#8a58bb"/>
                                    <Setter Property="Opacity" Value="50"></Setter>
                                </Style>
                            </TabItem.Styles>
                            
                            <TabItem.Header>
                                <Border Margin="9 0 0 0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Svg Margin="0 0 0 0" Path="/Assets/Images/svg/profile.svg" Width="30" Height="30"/>
                                        <TextBlock Margin="0 0 0 0" Foreground="White" FontFamily="{StaticResource MontserratBold}" FontSize="18" Text="Профиль"></TextBlock>
                                        <Rectangle Margin="0 0 0 0" Height="1" Fill="White" HorizontalAlignment="Stretch"></Rectangle>
                                    </StackPanel>
                                </Border>
                            </TabItem.Header>
                            
                            <!-- Profile Content -->
                            <Border Grid.Column="0"
                                    Background="#201E24"
                                    Margin="10"
                                    CornerRadius="5"
                                    BorderBrush="Black"
                                    BorderThickness="1">
                                <StackPanel>
                                    <StackPanel>
                                        <Border Background="#1b191f" CornerRadius="5 5 0 0">
                                            <TextBlock Text="Профиль"
                                                       FontSize="18"
                                                       FontFamily="{StaticResource MontserratBold}"
                                                       Margin="10"
                                                       TextAlignment="Center"/>
                                        </Border>
                                        <Rectangle Height="1" Fill="Black"></Rectangle>
                                    </StackPanel>
                                    
                                    <!-- Profile Options -->
                                    <StackPanel Margin="20">
                                        <!-- Add Password Button -->
                                        <Button Foreground="White"
                                                Classes="idle_anim"
                                                VerticalAlignment="Bottom"
                                                CornerRadius="5"
                                                MaxWidth="250"
                                                Height="40"
                                                Margin="0 10 0 20"
                                                Background="#6E53A1"
                                                x:Name="AddPasswordButton">
                                            <Button.Content>
                                                <Grid ColumnDefinitions="Auto, *" RowDefinitions="*">
                                                    <Svg Path="../Assets/Images/svg/lock.svg" Height="20" Width="20"/>
                                                    <TextBlock Grid.Column="1" 
                                                               FontFamily="{StaticResource MontserratBold}"
                                                               FontSize="15" 
                                                               Text="Добавить пароль" 
                                                               Margin="10 3 0 2"/>
                                                </Grid>
                                            </Button.Content>
                                        </Button>
                                        
                                        <!-- Connect Discord Button -->
                                        <Button Foreground="White"
                                                Classes="idle_anim"
                                                VerticalAlignment="Bottom"
                                                CornerRadius="5"
                                                MaxWidth="250"
                                                Height="40"
                                                Background="#5865F2"
                                                x:Name="ConnectDiscordButton">
                                            <Button.Content>
                                                <Grid ColumnDefinitions="Auto, *" RowDefinitions="*">
                                                    <Svg Path="../Assets/Images/svg/discord.svg" Height="20" Width="20"/>
                                                    <TextBlock Grid.Column="1" 
                                                               FontFamily="{StaticResource MontserratBold}"
                                                               FontSize="15" 
                                                               Text="Подключить Discord" 
                                                               Margin="10 3 0 2"/>
                                                </Grid>
                                            </Button.Content>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </TabItem>
                    </TabControl>
                </StackPanel>

                <!-- Right Side Stack -->
                <Border Grid.Row="0" Grid.Column="1"
                        Background="#BD201E24"
                        Padding="4"
                        Margin="10 60 20 60"
                        CornerRadius="5"
                        BorderBrush="#BD000000"
                        BorderThickness="1">
                    <StackPanel Spacing="10">
                        
                        <!-- Player Profile -->
                        <Border Height="60" Opacity="40" CornerRadius="5" BorderBrush="Black" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,50%">
                                    <GradientStop Color="#201e24" Offset="0.0"></GradientStop>
                                    <GradientStop Color="#29282C" Offset="1.0"></GradientStop>
                                </LinearGradientBrush>
                            </Border.Background>
                            
                            <StackPanel Orientation="Horizontal" Margin="10 0 0 0">
                                <Image Source="/Assets/Images/stevehead.png"
                                       Width="30"
                                       Height="30" />
                                <TextBlock Text="{Binding PlayerName}"
                                           FontFamily="{StaticResource MontserratRegular}"
                                           Margin="10 20 0 0"
                                           FontSize="14"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Selected Server View -->
                        <Border Opacity="40" CornerRadius="5" BorderBrush="Black" BorderThickness="1" Padding="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,50%">
                                    <GradientStop Color="#201e24" Offset="0.0"></GradientStop>
                                    <GradientStop Color="#29282C" Offset="1.0"></GradientStop>
                                </LinearGradientBrush>
                            </Border.Background>
                            
                            <StackPanel Spacing="10"> 
                                <TextBlock Text="Выбранный сервер:"
                                   FontFamily="{StaticResource MontserratBold}"
                                   FontSize="16"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
                                    <Image Source="{Binding SelectedModpack.Icon}" Width="30" />
                                    <TextBlock Text="{Binding SelectedModpack.Name}"
                                       FontFamily="{StaticResource MontserratRegular}"
                                       FontSize="15"/>
                                </StackPanel>
                                    <Button Foreground="White"
                                        Classes="idle_anim"
                                        VerticalAlignment="Bottom"
                                        CornerRadius="5"
                                        MaxWidth="210"
                                        Height="35"
                                        Background="#6E53A1"
                                        Click="OnShowFolderClicked">
                                    <Button.Content>
                                        <Grid ColumnDefinitions="*, 150" RowDefinitions="*, Auto">
                                            <Svg Path="/Assets/Images/svg/folder.svg" Height="20" Width="20"/>
                                            <StackPanel Grid.Column="1" Grid.Row="0">
                                                <TextBlock FontFamily="{StaticResource MontserratBold}"
                                                           FontSize="15" Text="Показать папку" Margin="10 3 0 2"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button.Content>

                                    <!-- <Button.Styles> -->
                                    <!--     <Style Selector="Button.idle_anim"> -->
                                    <!--         <Style.Animations> -->
                                    <!--             <Animation Duration="0:0:5" PlaybackDirection="AlternateReverse" IterationCount="INFINITE"> -->
                                    <!--                 <KeyFrame Cue="0%" > -->
                                    <!--                     <Setter Property="Background"> -->
                                    <!--                         <Setter.Value> -->
                                    <!--                             <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,50%"> -->
                                    <!--                                 <GradientStop Color="#551E6E" Offset="0.2" /> -->
                                    <!--                                 <GradientStop Color="#EA4BED" Offset="1.0" /> -->
                                    <!--                             </LinearGradientBrush> -->
                                    <!--                         </Setter.Value> -->
                                    <!--                     </Setter> -->
                                    <!--                 </KeyFrame> -->
                                    <!--             </Animation> -->
                                    <!--         </Style.Animations> -->
                                    <!--     </Style> -->
                                    <!-- </Button.Styles> -->
                                    
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Bottom Launch Panel -->
                <StackPanel Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Grid.Column="0"
                            Margin="10">
                    <Grid ColumnDefinitions="*, 250">
                        <Grid Grid.Column="0"
                              ColumnDefinitions="*, 300"
                              RowDefinitions="*, *, *">
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       x:Name="TaskName"
                                       Text="Чего смотришь, иди игру играть..."
                                       FontFamily="{StaticResource MontserratLight}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DownloadSpeed"
                                       HorizontalAlignment="Right"
                                       Text="zzz..."
                                       FontFamily="{StaticResource MontserratLight}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DownloadProgress"
                                       HorizontalAlignment="Right"
                                       Text="zzz..."
                                       FontFamily="{StaticResource MontserratLight}" />
                            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" CornerRadius="0" ClipToBounds="True">
                                <ProgressBar x:Name="LaunchProgressBar" Value="0" Margin="0 10 0 0">
                                    <ProgressBar.Foreground>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,50%">
                                            <GradientStop Color="#8a58bb" Offset="0.2" />
                                            <GradientStop Color="#ee4aef" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </ProgressBar.Foreground>
                                </ProgressBar>
                            </Border>
                        </Grid>
                        
                        <Button x:Name="LaunchButton" Margin="12 0 0 0" CornerRadius="5"
                                Grid.Column="1" Click="OnLaunchButtonClicked" Content="Играть!"
                                Foreground="White" FontFamily="{StaticResource MontserratBold}"
                                FontSize="22" Classes="idle_anim">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,50%">
                                    <GradientStop Color="#8a58bb" Offset="0.2" />
                                    <GradientStop Color="#ee4aef" Offset="1.0" />
                                </LinearGradientBrush>
                            </Button.Background>
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,50%">
                                                <GradientStop Color="#7252A4" Offset="0.2" />
                                                <GradientStop Color="#904991" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                
                                <Style Selector="Button.idle_anim">
                                    <Style.Animations>
                                        <Animation Duration="0:0:5" PlaybackDirection="AlternateReverse" IterationCount="INFINITE">
                                            <KeyFrame Cue="0%" >
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,50%">
                                                            <GradientStop Color="#551E6E" Offset="0.2" />
                                                            <GradientStop Color="#EA4BED" Offset="1.0" />
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </Button.Styles>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>