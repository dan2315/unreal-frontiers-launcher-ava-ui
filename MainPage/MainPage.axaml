<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:UnrealFrontiersLauncher.ViewModels"
        xmlns:converters="using:UnrealFrontiersLauncher.Converters"
        xmlns:elements="using:UnrealFrontiersLauncher"
        x:Class="UnrealFrontiersLauncher.MainPage"
        x:DataType="local:MainPageViewModel">

    <UserControl.Resources>
        <converters:MultiConditionColorConverter x:Key="MultiConditionColorConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Background Image -->
        <Image Source="/Assets/Images/background_image.png"
           Stretch="UniformToFill"
           Grid.ColumnSpan="2" />

        
        <!-- Left Side Panel -->
        <StackPanel Grid.Column="0"
                    Background="#201E24"
                    Width="230">
            <TextBlock Text="Modpacks"
                       TextAlignment="Center"
                       FontSize="34"
                       Foreground="White"
                       Margin="0,5,0,20"
                       FontFamily="MontserratBold" />

            <!-- Modpack Collection -->
            <ListBox x:Name="ModpackCollectionView"
                              ItemsSource="{Binding Modpacks}"
                              SelectedItem="{Binding SelectedModpack}"
                              SelectionChanged="OnInstanceSelected">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Background="#201E24">
                            <Border Background="{Binding BackgroundColor}"
                                    Margin="0,10,0,10"
                                    Padding="5"
                                    CornerRadius="10">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon}"
                                           Width="30"
                                           Height="30"
                                           Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="16"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding SelectionAndHoverState, Converter={StaticResource MultiConditionColorConverter}}"
                                               FontFamily="MontserratLight"/>
                                </StackPanel>
                            </Border>
                            <!-- Divider Line -->
                            <Rectangle Height="1"
                                       Fill="#404040"
                                       HorizontalAlignment="Stretch"
                                       IsVisible="{Binding IsLastItem}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Opacity" Value="75"></Setter>
                        <!-- <Setter Property="CornerRadius" Value="16"></Setter> -->
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="VerticalAlignment" Value="Bottom"></Setter>
                        <!-- <Setter Property="Opacity" Value="75"></Setter> -->
                        <!-- <Setter Property="CornerRadius" Value="16"></Setter> -->
                    </Style>
                </ListBox.Styles>
            </ListBox>

            <!-- Settings Button -->
            <elements:PrimaryButton Content="Показать папку"
                Foreground="White"
                Background="MediumPurple"
                FontFamily="MontserratBold"

                VerticalAlignment="Bottom"
                Margin="0,0,0,50">
            </elements:PrimaryButton>    
        </StackPanel>

        <!-- Right Side Panel --> 
        <DockPanel Grid.Column="1">
            <Grid ColumnDefinitions="*, 250" RowDefinitions="*, Auto" DockPanel.Dock="Top">
                <!-- Tab Content -->
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Stretch"
                            Orientation="Horizontal">
                    <TabControl Margin="10 0 10 0">
                        <TabItem Margin="0 0 10 0" CornerRadius="0 0 5 5" Width="125">
                            <!-- <TabItem.Background> -->
                            <!--     <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,50%" Opacity="75"> -->
                            <!--         <GradientStop Color="#8a58bb" Offset="0.35" /> -->
                            <!--         <GradientStop Color="#f772ff" Offset="1.0" /> -->
                            <!--     </LinearGradientBrush> -->
                            <!-- </TabItem.Background> -->
                            
                            <TabItem.Header>
                                <StackPanel>
                                    <Image Source="../Assets/Images/sword.png" Width="30" Height="30" Margin="30 0 0 0"></Image>
                                    <TextBlock Margin="25 0 0 0" Foreground="White" FontFamily="MontserratBold" FontSize="18" Text="Играть!"></TextBlock>
                                    <Rectangle Margin="25 0 0 0" Height="1" Fill="White" IsVisible="{Binding}" HorizontalAlignment="Stretch"></Rectangle>
                                </StackPanel>
                            </TabItem.Header>
                            
                            <TabItem.Styles>
                                <Style Selector="TabItem:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,50%" Opacity="75">
                                                <GradientStop Color="#8a58bb" Offset="0.2" />
                                                <GradientStop Color="#ee4aef" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Opacity" Value="30"></Setter>
                                </Style>
                                
                                <Style Selector="TabItem:selected  /template/ ContentPresenter">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,50%" Opacity="75">
                                                <GradientStop Color="#8a58bb" Offset="0.2" />
                                                <GradientStop Color="#ee4aef" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                
                                <Style Selector="TabItem:selected:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            #8a58bb
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TabItem.Styles>
                            <TextBlock Margin="5">This is tab 1 content</TextBlock>
                        </TabItem>
                        
                        <TabItem Margin=" 0 0 10 0" CornerRadius="0 0 5 5" Width="125">
                            <!-- <TabItem.Background> -->
                            <!--     <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,50%" Opacity="75"> -->
                            <!--         <GradientStop Color="#8a58bb" Offset="0.2" /> -->
                            <!--         <GradientStop Color="#ee4aef" Offset="1.0" /> -->
                            <!--     </LinearGradientBrush> -->
                            <!-- </TabItem.Background> -->
                            
                            <TabItem.Styles>
                                <Style Selector="TabItem:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,50%" Opacity="75">
                                                <GradientStop Color="#8a58bb" Offset="0.2" />
                                                <GradientStop Color="#ee4aef" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Opacity" Value="30"></Setter>
                                </Style>
                                
                                <Style Selector="TabItem:selected  /template/ ContentPresenter">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,50%" Opacity="75">
                                                <GradientStop Color="#8a58bb" Offset="0.2" />
                                                <GradientStop Color="#ee4aef" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                
                                <Style Selector="TabItem:selected:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            #8a58bb
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TabItem.Styles>
                            
                            <TabItem.Header>
                                <StackPanel>
                                    <Image Margin="5 0 0 0" Source="../Assets/Images/settings.png" Width="30" Height="30"></Image>
                                    <TextBlock Margin="10 0 0 0" Foreground="White" FontFamily="{StaticResource MontserratBold}" FontSize="18" Text="Настройки"></TextBlock>
                                    <Rectangle Margin="10 0 0 0" Height="1" Fill="White" IsVisible="{Binding}" HorizontalAlignment="Stretch"></Rectangle>
                                </StackPanel>
                            </TabItem.Header>
                            
                            <!-- Ебанина с настройками -->
                            <Border Grid.Column="0"
                                    Background="#201E24"
                                    Margin="10"
                                    CornerRadius="5"
                                    BorderBrush="White"
                                    BorderThickness="1">
                                <StackPanel>

                                    <StackPanel>
                                        <Border Background="#1b191f" CornerRadius="5 5 0 0">
                                            <TextBlock Text="Настройки"
                                                       FontSize="18"
                                                       FontFamily="MontserratBold"
                                                       Margin="10"
                                                       TextAlignment="Center"/>
                                        </Border>
                                        <Rectangle Height="1" Fill="White"></Rectangle>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal"
                                                Background="#2f2d36"
                                                Spacing="15"
                                                Margin="0 10 0 10">
                                        <TextBlock Text="RAM:"
                                                VerticalAlignment="Center"
                                                FontFamily="MontserratRegular"
                                                Margin="5 0 0 0"/>
                                        <Slider x:Name="RamSlider"
                                                Width="400"
                                                VerticalAlignment="Center" />
                                        <TextBox x:Name="RamEntry"
                                                Width="140"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Margin="0 0 5 0"/>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal"
                                                Background="#2f2d36"
                                                Spacing="15">
                                        <TextBlock Text="Открыть консоль:"
                                                VerticalAlignment="Center"
                                                FontFamily="MontserratRegular"
                                                Margin="5 5 0 0"/>
                                        <CheckBox IsEnabled="False"
                                                  Margin="0 5 0 0"/>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal"
                                                Background="#2f2d36"
                                                Spacing="15">
                                        <TextBlock Text="Закрыть лаунчер при запуске:"
                                                VerticalAlignment="Center"
                                                FontFamily="MontserratRegular" 
                                                Margin="5 0 0 10"/>
                                        
                                        <CheckBox IsEnabled="False" 
                                                  Margin="0 0 0 8"/>
                                    </StackPanel>
                                    <Rectangle Height="1" Fill="White"></Rectangle>
                                </StackPanel>
                            </Border>
                        </TabItem>
                    </TabControl>
                </StackPanel>

                <!-- Player Profile -->
                <Border Grid.Column="1"
                        Background="#201E24"
                        Margin="10 10 20 10"
                        CornerRadius="20">
                    <StackPanel>
                        <Border Height="60" Opacity="40" CornerRadius="20 20 0 0">
                            
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,50%">
                                    <GradientStop Color="#201e24" Offset="0.0"></GradientStop>
                                    <GradientStop Color="#444444" Offset="0.5"></GradientStop>
                                    <GradientStop Color="#333333" Offset="1.0"></GradientStop>
                                </LinearGradientBrush>
                            </Border.Background>
                            
                            <StackPanel Orientation="Horizontal" Margin="20 0 0 0">
                                <Image Source="/Assets/Images/stevehead.png"
                                       Width="30"
                                       Height="30" />
                                <TextBlock Text="{Binding PlayerName}"
                                           FontFamily="MontserratRegular"
                                           Margin="10"
                                           FontSize="20"/>
                            </StackPanel>
                        </Border>
                        
                        <TextBlock/>
                        
                        <Border Height="100" Opacity="40" >
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,50%">
                                    <GradientStop Color="#201e24" Offset="0.0"></GradientStop>
                                    <GradientStop Color="#444444" Offset="0.5"></GradientStop>
                                    <GradientStop Color="#333333" Offset="1.0"></GradientStop>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Margin="20 10 0 0">
                                <TextBlock Text="Выбранный сервер:"
                                   FontFamily="MontserratBold"
                                   FontSize="20"
                                   Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding SelectedModpack.Icon}" Width="30" />
                                    <TextBlock Text="{Binding SelectedModpack.Name}"
                                       FontFamily="MontserratRegular"
                                       FontSize="15"
                                       Margin="10" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Bottom Launch Panel -->
                <StackPanel Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="10">
                    <Grid ColumnDefinitions="*, 250">
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="DownloadSpeed"
                                HorizontalAlignment="Right"
                                Text="zzz..."
                                FontFamily="MontserratLight" />
                            <TextBlock x:Name="TaskName"
                                Text="Чего смотришь, иди игру играть..."
                                FontFamily="MontserratLight" />
                            <ProgressBar x:Name="LaunchProgressBar"
                                Value="50"
                                Foreground="#EE4AEF" />
                        </StackPanel>
                        <Button x:Name="LaunchButton"
                                Margin="12 0 0 0"    
                                CornerRadius="5"
                                Grid.Column="1"
                                Click="OnLaunchButtonClicked"
                                Content="Играть"
                                Background="#6D208F"
                                Foreground="White"
                                FontFamily="MontserratBold"
                                FontSize="22">
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </DockPanel>

    </Grid>
</UserControl>