<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:UnrealFrontiersLauncher"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="UnrealFrontiersLauncher.LoggingWindow"
        x:DataType="local:LoggingWindow"
        Title="Game Console"
        Width="800" Height="500">
    <Grid RowDefinitions="Auto, *">
        <!-- <StackPanel Orientation="Horizontal" Margin="5" Spacing="25"> -->
        <!--     <TextBox x:Name="SearchBox" Watermark="Search logs..."  -->
        <!--              Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" /> -->
        <!--     <CheckBox x:Name="ScrollToBottomCheckBox" Content="Scroll to Bottom"  -->
        <!--               IsChecked="{Binding ScrollToBottom}" Margin="10,0,0,0"/> -->
        <!-- </StackPanel> -->
        <ListBox x:Name="LogsListBox" Grid.Row="1" ItemsSource="{Binding FilteredLogs}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                        <TextBlock Text="{Binding}" 
                                   TextWrapping="Wrap" 
                                   HorizontalAlignment="Stretch"
                                   MaxWidth="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Width}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window> 