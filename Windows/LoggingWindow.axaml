<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:UnrealFrontiersLauncher"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="UnrealFrontiersLauncher.LoggingWindow"
        x:DataType="local:LoggingWindow"
        Title="Game Console"
        Width="860" Height="540"
        MinWidth="560" MinHeight="360"
        Background="#100F12">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="#0C0B0E" BorderBrush="#232127" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Image Source="{StaticResource UfLogoBadge}" Height="24" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Text="Game Console" FontFamily="{StaticResource MontserratBold}"
                           FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                <Border Height="2" Width="48" CornerRadius="1" VerticalAlignment="Center"
                        Background="{StaticResource UfAccentGradient}"/>
            </StackPanel>
        </Border>
        <ListBox Grid.Row="1" x:Name="LogsListBox" ItemsSource="{Binding FilteredLogs}"
                 Background="#0C0B0E" BorderThickness="0" Margin="8">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               TextWrapping="Wrap"
                               FontFamily="Consolas,Menlo,monospace"
                               FontSize="12"
                               Foreground="#C9CFD6"
                               Padding="2,1"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
