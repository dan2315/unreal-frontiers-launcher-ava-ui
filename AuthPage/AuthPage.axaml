<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:UnrealFrontiersLauncher"
             xmlns:converters="using:UnrealFrontiersLauncher.Converters"
             x:Class="UnrealFrontiersLauncher.AuthPage"
             x:DataType="local:AuthPageViewModel">
    <UserControl.Resources>
        <converters:TextToVisibilityConverter x:Key="TextToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" Source="/Assets/Images/backgorund2.png" />
        </Grid.Background>
        <Border Opacity="0.78">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#0B0A0E" Offset="0.0" />
                    <GradientStop Color="#121420" Offset="0.55" />
                    <GradientStop Color="#0A1F18" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Main Layout -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,14,0,14">
                <Image Source="{StaticResource UfLogoBanner}" Stretch="Uniform"
                       MaxWidth="420" MaxHeight="92" Margin="0,0,0,0"/>
                <Border Background="#16141B" Opacity="0.96"
                        BorderBrush="#2E2C34" BorderThickness="1"
                        CornerRadius="24"
                        Width="420"
                        Padding="36,20">
                    <StackPanel Spacing="8">
                        <!-- The title block. An error flashes over it (it takes no room of its own), so nothing moves. -->
                        <Grid>
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding PageTitle}"
                                           FontFamily="{StaticResource MontserratBold}"
                                           FontSize="22"
                                           Foreground="White"
                                           HorizontalAlignment="Center"/>
                                <Border Height="2" Width="64" CornerRadius="1"
                                        HorizontalAlignment="Center"
                                        Background="{StaticResource UfAccentGradient}"/>
                            </StackPanel>
                            <Border x:Name="ErrorBox" Opacity="0" Background="#3A1518" BorderBrush="#E5484D" BorderThickness="1"
                                    CornerRadius="10" VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    IsVisible="{Binding AuthError, Converter={StaticResource TextToVisibilityConverter}}">
                                <TextBlock Text="{Binding AuthError}"
                                           Foreground="#FF9B9E"
                                           FontSize="12"
                                           TextAlignment="Center"
                                           FontFamily="{StaticResource MontserratRegular}"
                                           Padding="10,5"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </Grid>

                        <!-- Registered, but the email is not confirmed yet. -->
                        <StackPanel Spacing="10" IsVisible="{Binding IsVerificationPending}">
                            <Border Background="#33290F" BorderBrush="#E8B83A" BorderThickness="1" CornerRadius="10">
                                <TextBlock Text="Аккаунт с этим email уже зарегистрирован, но почта не подтверждена. Найдите письмо от нас (проверьте «Спам») или отправьте его ещё раз."
                                           Foreground="#F2D58A"
                                           FontSize="13"
                                           TextAlignment="Center"
                                           FontFamily="{StaticResource MontserratRegular}"
                                           Padding="10,8"
                                           TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock Text="{Binding ResendMessage}"
                                       Foreground="#B9BDC2"
                                       FontSize="13"
                                       TextAlignment="Center"
                                       MinHeight="20"
                                       FontFamily="{StaticResource MontserratRegular}"
                                       TextWrapping="Wrap"/>
                            <Button Content="Отправить ещё раз"
                                    Click="ResendVerification"
                                    IsEnabled="{Binding CanResend}"
                                    Classes="uf-auth"
                                    FontFamily="{StaticResource MontserratBold}"
                                    FontSize="16"
                                    Height="44"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"/>
                            <Button Content="Назад"
                                    Click="BackToForm"
                                    Classes="uf-outline"
                                    FontFamily="{StaticResource MontserratBold}"
                                    FontSize="14"
                                    Height="42"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Spacing="8" IsVisible="{Binding IsFormVisible}">

                        <!-- Nickname Entry -->
                        <StackPanel Spacing="4">
                            <TextBox Text="{Binding NicknameEntry.Value}"
                                     Watermark="Enter nickname"
                                     VerticalContentAlignment="Center"
                                     Classes="uf-field"
                                     Foreground="White"
                                     Height="42">
                                <TextBox.InnerLeftContent>
                                    <Svg Path="/Assets/Images/svg/user.svg" Width="18" Height="18" Margin="0,0,8,0"/>
                                </TextBox.InnerLeftContent>
                            </TextBox>
                            <TextBlock Text="{Binding NicknameEntry.ValidationMessage}"
                                       FontFamily="{StaticResource MontserratRegular}"
                                       FontSize="12" Foreground="#FF9B9E"
                                       IsVisible="{Binding NicknameEntry.IsVisible}" />
                        </StackPanel>

                        <!-- Email Entry -->
                        <StackPanel Spacing="4"
                                    IsVisible="{Binding IsRegisterMode}">
                            <TextBox Text="{Binding EmailEntry.Value}"
                                     Watermark="Enter email"
                                     VerticalContentAlignment="Center"
                                     Classes="uf-field"
                                     Foreground="White"
                                     Height="42">
                                <TextBox.InnerLeftContent>
                                    <Svg Path="/Assets/Images/svg/mail.svg" Width="18" Height="18" Margin="0,0,8,0"/>
                                </TextBox.InnerLeftContent>
                            </TextBox>
                            <TextBlock Text="{Binding EmailEntry.ValidationMessage}"
                                       FontFamily="{StaticResource MontserratRegular}"
                                       FontSize="12" Foreground="#FF9B9E"
                                       IsVisible="{Binding EmailEntry.IsVisible}" />
                        </StackPanel>

                        <!-- Password Entry -->
                        <StackPanel Spacing="4">
                            <TextBox Text="{Binding PasswordEntry.Value}"
                                     Watermark="Enter password"
                                     VerticalContentAlignment="Center"
                                     PasswordChar="•"
                                     Classes="uf-field"
                                     Foreground="White"
                                     Height="42">
                                <TextBox.InnerLeftContent>
                                    <Svg Path="/Assets/Images/svg/key.svg" Width="18" Height="18" Margin="0,0,8,0"/>
                                </TextBox.InnerLeftContent>
                            </TextBox>
                            <TextBlock Text="{Binding PasswordEntry.ValidationMessage}"
                                       FontFamily="{StaticResource MontserratRegular}"
                                       FontSize="12" Foreground="#FF9B9E"
                                       IsVisible="{Binding PasswordEntry.IsVisible}" />
                        </StackPanel>

                        <!-- Repeat Password Entry -->
                        <StackPanel Spacing="4"
                                    IsVisible="{Binding IsRegisterMode}">
                            <TextBox Text="{Binding RepeatPasswordEntry.Value}"
                                     Watermark="Repeat password"
                                     VerticalContentAlignment="Center"
                                     PasswordChar="•"
                                     Classes="uf-field"
                                     Foreground="White"
                                     Height="42">
                                <TextBox.InnerLeftContent>
                                    <Svg Path="/Assets/Images/svg/key_check.svg" Width="18" Height="18" Margin="0,0,8,0"/>
                                </TextBox.InnerLeftContent>
                            </TextBox>
                            <TextBlock Text="{Binding RepeatPasswordEntry.ValidationMessage}"
                                       FontFamily="{StaticResource MontserratRegular}"
                                       FontSize="12" Foreground="#FF9B9E"
                                       IsVisible="{Binding RepeatPasswordEntry.IsVisible}" />
                        </StackPanel>

                        <Button x:Name="ActionButton"
                                Content="{Binding ActionButtonText}"
                                Click="AuthAction"
                                Classes="uf-auth"
                                FontFamily="{StaticResource MontserratBold}"
                                FontSize="16"
                                Height="44" Margin="0,4,0,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>

                        <Grid ColumnDefinitions="*,*"
                              IsVisible="{Binding IsLoginMode}">
                            <Button Grid.Column="0" x:Name="StartDiscordAuthButton"
                                    Click="InitiateDiscordAuth"
                                    Classes="uf-discord"
                                    Margin="0,0,5,0"
                                    Height="40">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <Svg Path="/Assets/Images/svg/discord_icon.svg" Height="20" Width="20"/>
                                    <TextBlock FontFamily="{StaticResource MontserratBold}"
                                               FontSize="13" VerticalAlignment="Center">Discord</TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1"
                                    Content="Google (WIP)"
                                    IsEnabled="False"
                                    Margin="5,0,0,0"
                                    Height="40"
                                    Background="#26232C"
                                    Foreground="#7C828A"
                                    FontFamily="{StaticResource MontserratRegular}"
                                    FontSize="13"
                                    BorderThickness="0"
                                    CornerRadius="10"/>
                        </Grid>

                        <Button Content="{Binding ToggleMessage}"
                                Click="ToggleViewButton"
                                Classes="uf-outline"
                                FontFamily="{StaticResource MontserratBold}"
                                FontSize="14"
                                Height="42" Margin="0,4,0,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>
                        <TextBlock Text="Забыли пароль?"
                                   Foreground="#B9BDC2"
                                   TextDecorations="Underline"
                                   HorizontalAlignment="Center"
                                   FontFamily="{StaticResource MontserratBold}"
                                   FontSize="14"
                                   Cursor="Hand"
                                   PointerPressed="InitiatePasswordRecovery"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
