<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:UnrealFrontiersLauncher"
             xmlns:converters="using:UnrealFrontiersLauncher.Converters"
             x:Class="UnrealFrontiersLauncher.AuthPage"
             x:DataType="local:AuthPageViewModel">
    <UserControl.Resources>
        <converters:TextToVisibilityConverter x:Key="TextToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" Source="/Assets/Images/backgorund2.png" />
        </Grid.Background>
        <Border Opacity="0.78">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#0B0A0E" Offset="0.0" />
                    <GradientStop Color="#121420" Offset="0.55" />
                    <GradientStop Color="#0A1F18" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Main Layout -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,32,0,32">
                <Image Source="{StaticResource UfLogoBanner}" Stretch="Uniform"
                       MaxWidth="420" Margin="0,0,0,4"/>
                <Border Background="#16141B" Opacity="0.96"
                        BorderBrush="#2E2C34" BorderThickness="1"
                        CornerRadius="24"
                        Width="420"
                        Padding="36,28">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding PageTitle}"
                                   FontFamily="{StaticResource MontserratBold}"
                                   FontSize="24"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <Border Height="2" Width="64" CornerRadius="1"
                                HorizontalAlignment="Center"
                                Background="{StaticResource UfAccentGradient}"/>

                        <!-- Auth Error -->
                        <Border Background="#3A1518" BorderBrush="#E5484D" BorderThickness="1"
                                CornerRadius="10" Margin="0,8,0,0"
                                IsVisible="{Binding AuthError, Converter={StaticResource TextToVisibilityConverter}}">
                            <TextBlock Text="{Binding AuthError}"
                                       Foreground="#FF9B9E"
                                       FontSize="13"
                                       TextAlignment="Center"
                                       FontFamily="{StaticResource MontserratRegular}"
                                       Padding="10,8"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- Nickname Entry -->
                        <StackPanel Spacing="4" Margin="0,8,0,0">
                            <TextBox Text="{Binding NicknameEntry.Value}"
                                     Watermark="Enter nickname"
                                     VerticalContentAlignment="Center"
                                     Classes="uf-field"
                                     Foreground="White"
                                     Height="42"/>
                            <TextBlock Text="{Binding NicknameEntry.ValidationMessage}"
                                       FontFamily="{StaticResource MontserratRegular}"
                                       FontSize="12" Foreground="#FF9B9E"
                                       IsVisible="{Binding NicknameEntry.IsVisible}" />
                        </StackPanel>

                        <!-- Email Entry -->
                        <StackPanel Spacing="4"
                                    IsVisible="{Binding IsRegisterMode}">
                            <TextBox Text="{Binding EmailEntry.Value}"
                                     Watermark="Enter email"
                                     VerticalContentAlignment="Center"
                                     Classes="uf-field"
                                     Foreground="White"
                                     Height="42"/>
                            <TextBlock Text="{Binding EmailEntry.ValidationMessage}"
                                       FontFamily="{StaticResource MontserratRegular}"
                                       FontSize="12" Foreground="#FF9B9E"
                                       IsVisible="{Binding EmailEntry.IsVisible}" />
                        </StackPanel>

                        <!-- Password Entry -->
                        <StackPanel Spacing="4">
                            <TextBox Text="{Binding PasswordEntry.Value}"
                                     Watermark="Enter password"
                                     VerticalContentAlignment="Center"
                                     PasswordChar="•"
                                     Classes="uf-field"
                                     Foreground="White"
                                     Height="42"/>
                            <TextBlock Text="{Binding PasswordEntry.ValidationMessage}"
                                       FontFamily="{StaticResource MontserratRegular}"
                                       FontSize="12" Foreground="#FF9B9E"
                                       IsVisible="{Binding PasswordEntry.IsVisible}" />
                        </StackPanel>

                        <!-- Repeat Password Entry -->
                        <StackPanel Spacing="4"
                                    IsVisible="{Binding IsRegisterMode}">
                            <TextBox Text="{Binding RepeatPasswordEntry.Value}"
                                     Watermark="Repeat password"
                                     VerticalContentAlignment="Center"
                                     PasswordChar="•"
                                     Classes="uf-field"
                                     Foreground="White"
                                     Height="42"/>
                            <TextBlock Text="{Binding RepeatPasswordEntry.ValidationMessage}"
                                       FontFamily="{StaticResource MontserratRegular}"
                                       FontSize="12" Foreground="#FF9B9E"
                                       IsVisible="{Binding RepeatPasswordEntry.IsVisible}" />
                        </StackPanel>

                        <Button x:Name="ActionButton"
                                Content="{Binding ActionButtonText}"
                                Click="AuthAction"
                                Classes="uf-primary"
                                FontFamily="{StaticResource MontserratBold}"
                                FontSize="16"
                                Height="44" Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>

                        <Grid ColumnDefinitions="*,*"
                              IsVisible="{Binding IsLoginMode}">
                            <Button Grid.Column="0" x:Name="StartDiscordAuthButton"
                                    Click="InitiateDiscordAuth"
                                    Classes="uf-discord"
                                    Height="40">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <Svg Path="/Assets/Images/svg/discord_icon.svg" Height="20" Width="20"/>
                                    <TextBlock FontFamily="{StaticResource MontserratBold}"
                                               FontSize="13" VerticalAlignment="Center">Discord</TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1"
                                    Content="Google (WIP)"
                                    IsEnabled="False"
                                    Height="40"
                                    Background="#26232C"
                                    Foreground="#7C828A"
                                    FontFamily="{StaticResource MontserratRegular}"
                                    FontSize="13"
                                    BorderThickness="0"
                                    CornerRadius="10"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
                            <TextBlock Text="{Binding ToggleMessage}"
                                       Grid.Column="0"
                                       Foreground="#B9BDC2"
                                       TextDecorations="Underline"
                                       HorizontalAlignment="Center"
                                       FontFamily="{StaticResource MontserratBold}"
                                       FontSize="14"
                                       Cursor="Hand"
                                       PointerPressed="ToggleView"/>
                            <TextBlock Text="Забыли пароль?"
                                       Grid.Column="1"
                                       Foreground="#B9BDC2"
                                       TextDecorations="Underline"
                                       HorizontalAlignment="Center"
                                       FontFamily="{StaticResource MontserratBold}"
                                       FontSize="14"
                                       Cursor="Hand"
                                       PointerPressed="InitiatePasswordRecovery"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
