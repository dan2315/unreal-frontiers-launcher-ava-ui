<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:UnrealFrontiersLauncher"
             xmlns:converters="using:UnrealFrontiersLauncher.Converters"
             x:Class="UnrealFrontiersLauncher.AuthPage"
             x:DataType="local:AuthPageViewModel">
    <UserControl.Resources>
        <converters:TextToVisibilityConverter x:Key="TextToVisibilityConverter"/>
    </UserControl.Resources>
    <UserControl.Styles>
        <!-- The show/hide eye inside the password field: just the icon, no button chrome. -->
        <Style Selector="ToggleButton.uf-eye">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ToggleButton.uf-eye /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Styles>
    <Grid>
        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" Source="/Assets/Images/backgorund2.png" />
        </Grid.Background>
        <Border Opacity="0.78">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#0B0A0E" Offset="0.0" />
                    <GradientStop Color="#121420" Offset="0.55" />
                    <GradientStop Color="#0A1F18" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Main Layout -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,14,0,14">
                <Image Source="{StaticResource UfLogoBanner}" Stretch="Uniform"
                       MaxWidth="420" MaxHeight="92" Margin="0,0,0,0"/>
                <Border Background="#16141B" Opacity="0.96"
                        BorderBrush="#2E2C34" BorderThickness="1"
                        CornerRadius="24"
                        Width="420"
                        Padding="36,20">
                    <StackPanel Spacing="8">
                        <!-- The title block. An error flashes over it (it takes no room of its own), so nothing moves. -->
                        <Grid>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Войти"
                                           FontFamily="{StaticResource MontserratBold}"
                                           FontSize="22"
                                           Foreground="White"
                                           HorizontalAlignment="Center"/>
                                <Border Height="2" Width="64" CornerRadius="1"
                                        HorizontalAlignment="Center"
                                        Background="{StaticResource UfAccentGradient}"/>
                            </StackPanel>
                            <Border x:Name="ErrorBox" Opacity="0" Background="#3A1518" BorderBrush="#E5484D" BorderThickness="1"
                                    CornerRadius="10" VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    IsVisible="{Binding AuthError, Converter={StaticResource TextToVisibilityConverter}}">
                                <TextBlock Text="{Binding AuthError}"
                                           Foreground="#FF9B9E"
                                           FontSize="12"
                                           TextAlignment="Center"
                                           FontFamily="{StaticResource MontserratRegular}"
                                           Padding="10,5"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </Grid>

                        <!-- The email is not confirmed yet: what to do (the site can send the letter again). -->
                        <StackPanel Spacing="10" IsVisible="{Binding IsEmailNotVerified}">
                            <Border Background="#33290F" BorderBrush="#E8B83A" BorderThickness="1" CornerRadius="10">
                                <TextBlock Text="Аккаунт есть, но почта не подтверждена. Найдите письмо от нас (проверьте «Спам»). Если его нет, откройте сайт, введите тот же email и пароль, и мы предложим отправить письмо ещё раз."
                                           Foreground="#F2D58A"
                                           FontSize="13"
                                           TextAlignment="Center"
                                           FontFamily="{StaticResource MontserratRegular}"
                                           Padding="10,8"
                                           TextWrapping="Wrap"/>
                            </Border>
                            <Button Content="Открыть сайт"
                                    Click="OpenRegister"
                                    Classes="uf-auth"
                                    FontFamily="{StaticResource MontserratBold}"
                                    FontSize="16"
                                    Height="44"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"/>
                            <Button Content="Назад"
                                    Click="BackToForm"
                                    Classes="uf-outline"
                                    FontFamily="{StaticResource MontserratBold}"
                                    FontSize="14"
                                    Height="42"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Spacing="8" Margin="0,8,0,0" IsVisible="{Binding IsFormVisible}">

                        <!-- Nickname or email -->
                        <TextBox x:Name="NicknameBox"
                                 Text="{Binding Nickname}"
                                 Watermark="Ник или email"
                                 VerticalContentAlignment="Center"
                                 Classes="uf-field"
                                 Foreground="White"
                                 Height="42">
                            <TextBox.InnerLeftContent>
                                <Svg Path="/Assets/Images/svg/user.svg" Width="18" Height="18" Margin="0,0,8,0"/>
                            </TextBox.InnerLeftContent>
                        </TextBox>

                        <!-- Password, with the show/hide eye -->
                        <TextBox x:Name="PasswordBox"
                                 Text="{Binding Password}"
                                 Watermark="Пароль"
                                 VerticalContentAlignment="Center"
                                 PasswordChar="•"
                                 Classes="uf-field"
                                 Foreground="White"
                                 Height="42">
                            <TextBox.InnerLeftContent>
                                <Svg Path="/Assets/Images/svg/key.svg" Width="18" Height="18" Margin="0,0,8,0"/>
                            </TextBox.InnerLeftContent>
                            <TextBox.InnerRightContent>
                                <ToggleButton x:Name="PasswordEye" Classes="uf-eye"
                                              ToolTip.Tip="Показать пароль"
                                              Focusable="False">
                                    <Grid>
                                        <Svg x:Name="EyeShown" Path="/Assets/Images/svg/eye.svg" Width="18" Height="18"/>
                                        <Svg x:Name="EyeHidden" Path="/Assets/Images/svg/eye_off.svg" Width="18" Height="18" IsVisible="False"/>
                                    </Grid>
                                </ToggleButton>
                            </TextBox.InnerRightContent>
                        </TextBox>

                        <Button x:Name="ActionButton"
                                Content="Войти"
                                Click="AuthAction"
                                Classes="uf-auth"
                                FontFamily="{StaticResource MontserratBold}"
                                FontSize="16"
                                Height="44" Margin="0,4,0,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>

                        <!-- Discord, then the providers the backend has switched on (Google, Yandex): none of those is a fixed list. -->
                        <ItemsControl ItemsSource="{Binding SocialButtons}" Margin="-3,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:SocialButton">
                                    <Button Classes="uf-discord" Margin="3,0" Height="40"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Tag="{Binding Name}" Click="OnSocialClicked">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <Svg Path="{Binding IconPath}" IsVisible="{Binding HasIcon}" Height="20" Width="20"/>
                                            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource MontserratBold}"
                                                       FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="Нет аккаунта?"
                                Click="OpenRegister"
                                Classes="uf-outline"
                                FontFamily="{StaticResource MontserratBold}"
                                FontSize="14"
                                Height="42" Margin="0,4,0,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>
                        <TextBlock Text="Забыли пароль?"
                                   Foreground="#B9BDC2"
                                   TextDecorations="Underline"
                                   HorizontalAlignment="Center"
                                   FontFamily="{StaticResource MontserratBold}"
                                   FontSize="14"
                                   Cursor="Hand"
                                   PointerPressed="OpenForgotPassword"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
