<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="UnrealFrontiersLauncher.EntryModal">
    <Grid>
        <Grid MaxWidth="480" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
            <Border Classes="uf-card" Padding="28,24">
                <StackPanel Spacing="14">
                    <TextBlock x:Name="InfoLabel"
                               Text="Enter your input"
                               FontSize="17"
                               FontFamily="{StaticResource MontserratBold}"
                               Foreground="White"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                    <TextBox x:Name="UserInput"
                             Watermark="Type here..."
                             Classes="uf-field"
                             Height="42" />
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Button Content="Submit"
                                Classes="uf-primary"
                                FontFamily="{StaticResource MontserratBold}"
                                Padding="28,8"
                                FontSize="15"
                                Name="SubmitButton" />
                        <Button Content="Cancel"
                                Classes="uf-ghost"
                                FontFamily="{StaticResource MontserratBold}"
                                Padding="28,8"
                                FontSize="15"
                                Foreground="#B9BDC2"
                                Name="CancelButton" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
