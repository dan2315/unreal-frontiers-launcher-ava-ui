<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="launcher.EntryModal"
    xmlns:local="clr-namespace:launcher"
    NavigationPage.HasNavigationBar="False"
    NavigationPage.HasBackButton="False"
    Title="Modal Page">
    <VerticalStackLayout WidthRequest="600"
                         HeightRequest="500"
                         Padding="20"
                         Spacing="15">
        <Label x:Name="InfoLabel"
                Text="Enter your input"
                FontSize="20"
                FontFamily="MontserratBold"
                HorizontalOptions="Center"/>
        <Entry x:Name="UserInput"
                Placeholder="Type here..."/>
        <HorizontalStackLayout Spacing="10" HorizontalOptions="CenterAndExpand">
            <local:PrimaryButton Text="Submit"
                FontFamily="MontserratBold"
                    Clicked="OnSubmitClicked"
                    Padding="15"
                    FontSize="18"/>
            <local:PrimaryButton Text="Cancel"
                FontFamily="MontserratBold"
                    Clicked="OnCancelClicked"
                    Padding="15"
                    FontSize="18"/>
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>
