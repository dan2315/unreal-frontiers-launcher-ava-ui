using System.Globalization;


namespace launcher;

public class UniversalConverter : IValueConverter
{
    public object Convert(object value, Type targetType, object parameter, CultureInfo culture)
    {
        // Parameter can be a comma-separated list of conditions or expected values
        string[] parameters = (parameter as string)?.Split(',') ?? new string[0];

        if (parameters.Length > 1)
        {
            string expectedValue = parameters[0];
            string trueValue = parameters[1];
            string falseValue = parameters.Length > 2 ? parameters[2] : null;

            if (value?.ToString() == expectedValue)
            {
                return GetConvertedValue(trueValue, targetType);
            }
            else
            {
                return GetConvertedValue(falseValue, targetType);
            }
        }

        return value; // Return value if no conditions met
    }

    public object ConvertBack(object value, Type targetType, object parameter, CultureInfo culture)
    {
        throw new NotImplementedException();
    }

    private object GetConvertedValue(string value, Type targetType)
    {
        if (targetType == typeof(Color))
        {
            return Color.Parse(value);
        }
        else if (targetType == typeof(bool) && bool.TryParse(value, out bool result))
        {
            return result;
        }
        else if (targetType == typeof(double) && double.TryParse(value, out double doubleResult))
        {
            return doubleResult;
        }
        return value;
    }
    private object GetParameterValue(string param)
    {
        if (Application.Current.Resources.TryGetValue(param, out var resourceValue))
        {
            return resourceValue;
        }

        return param;
    }

}


public class MultiConditionColorConverter : IValueConverter
    {
        public object Convert(object value, Type targetType, object parameter, CultureInfo culture)
        {
            if (value is Tuple<bool, bool> conditions)
            {
                bool isSelected = conditions.Item1;
                bool isHovered = conditions.Item2;

                if (isSelected)
                    return Color.FromArgb("#FFFFFF");

                if (isHovered)
                    return Color.FromArgb("#FFFFFF");
            }
            return Color.FromArgb("#6F6F6F"); // Default color (e.g., transparent or black)
        }

        public object ConvertBack(object value, Type targetType, object parameter, CultureInfo culture)
        {
            throw new NotImplementedException();
        }
    }
