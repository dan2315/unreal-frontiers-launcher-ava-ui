using System;
using System.Globalization;
using Avalonia.Data.Converters;

namespace launcher.Converters
{
    public class BooleanToVisibilityConverter : IValueConverter
    {
        public object Convert(object value, Type targetType, object parameter, CultureInfo culture)
        {
            if (value is bool booleanValue)
            {
                bool invert = parameter != null && bool.TryParse(parameter.ToString(), out var paramValue) && paramValue;
                return (booleanValue ^ invert) ? Avalonia.Controls.Visibility.Visible : Avalonia.Controls.Visibility.Collapsed;
            }
            return Avalonia.Controls.Visibility.Collapsed;
        }

        public object ConvertBack(object value, Type targetType, object parameter, CultureInfo culture)
        {
            if (value is Avalonia.Controls.Visibility visibility)
            {
                return visibility == Avalonia.Controls.Visibility.Visible;
            }
            return false;
        }
    }
}
