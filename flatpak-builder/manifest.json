{
  "app-id": "com.unrealfrontiers.launcher",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "21.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "UnrealFrontiersLauncher",
  "modules": [
    {
      "name": "UnrealFrontiersLauncher",
      "buildsystem": "simple",
      "build-commands": [
        "make"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/example/UnrealFrontiersLauncher.git",
          "branch": "main"
        }
      ]
    }
  ],
  "metadata": {
    "name": "Unreal Frontiers",
    "description": "The Unreal Frontiers Launcher",
    "icon": "logo.png",
    "categories": ["Game"],
    "mime-types": ["x-scheme-handler/uflauncher"]
  },
  "files": {
    "/app/share/applications/UnrealFrontiers.desktop": {
      "source": "UnrealFrontiers.desktop",
      "path": "/app/share/applications/UnrealFrontiers.desktop"
    },
    "/app/share/icons/hicolor/256x256/apps/logo.png": {
      "source": "logo.png",
      "path": "/app/share/icons/hicolor/256x256/apps/logo.png"
    }
  }
}
