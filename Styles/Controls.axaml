<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Shared control theme for the launcher. -->

  <!-- Confirm button ("Готово", "Submit", changelog close): muted graphite
       with a mint edge on hover. Neon gradients stay reserved for "Играть". -->
  <Style Selector="Button.uf-accent">
    <Setter Property="Foreground" Value="{StaticResource UfTextBrush}" />
    <Setter Property="Background" Value="{StaticResource UfBtnBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource UfBtnBorderBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource UfRadiusM}" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.uf-accent /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.16" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.uf-accent:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource UfBtnHiBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource UfMintBrush}" />
  </Style>
  <Style Selector="Button.uf-accent:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource UfBtnDownBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource UfBtnBorderBrush}" />
    <Setter Property="RenderTransform" Value="scale(0.98)" />
  </Style>
  <Style Selector="Button.uf-accent:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource UfBtnDownBrush}" />
    <Setter Property="BorderBrush" Value="#2E2C34" />
    <Setter Property="TextBlock.Foreground" Value="#7C828A" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <!-- Sign-in button on the auth page: muted deep violet, calm next
       to the dark card. -->
  <Style Selector="Button.uf-auth">
    <Setter Property="Foreground" Value="{StaticResource UfTextBrush}" />
    <Setter Property="Background" Value="{StaticResource UfAuthBtnBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource UfAuthBtnBorderBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource UfRadiusM}" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.uf-auth /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.16" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.uf-auth:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource UfAuthBtnHiBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource UfAuthBtnBorderHiBrush}" />
  </Style>
  <Style Selector="Button.uf-auth:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource UfAuthBtnDownBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource UfAuthBtnBorderBrush}" />
    <Setter Property="RenderTransform" Value="scale(0.98)" />
  </Style>
  <Style Selector="Button.uf-auth:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource UfBtnDownBrush}" />
    <Setter Property="BorderBrush" Value="#2E2C34" />
    <Setter Property="TextBlock.Foreground" Value="#7C828A" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <!-- Launch button: static violet gradient. The breathing animation lives
       in uf-launch-animated (added by UiAnimations.ApplyLaunchStyle only
       when glow effects are enabled); static glow is a DropShadowEffect
       applied from code for the same reason. -->
  <Style Selector="Button.uf-launch">
    <Setter Property="Foreground" Value="{StaticResource UfTextBrush}" />
    <Setter Property="Background" Value="{StaticResource UfLaunchGradient}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource UfRadiusM}" />
    <Setter Property="Padding" Value="44,10" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <!-- NB: deliberately NO BrushTransition here. The breathing animation
       below rewrites Background every frame; a transition on the same
       property chases the animated value and the button gets stuck in a
       muddy mid-blend until hover pins a static color. States swap
       instantly, like before the redesign. -->
  <Style Selector="Button.uf-launch:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource UfLaunchHoverGradient}" />
  </Style>
  <Style Selector="Button.uf-launch:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource UfLaunchGradient}" />
    <Setter Property="RenderTransform" Value="scale(0.98)" />
  </Style>
  <Style Selector="Button.uf-launch:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="#3A3842" />
    <Setter Property="TextBlock.Foreground" Value="#7C828A" />
  </Style>

  <!-- Animated variant of the launch button: breathing violet gradient.
       Added/removed at runtime via UiAnimations.ApplyLaunchStyle so users
       can kill it on weak hardware (see UiGlowBox in global settings). -->
  <Style Selector="Button.uf-launch-animated">
    <Style.Animations>
      <Animation Duration="0:0:2.4" PlaybackDirection="Alternate" IterationCount="INFINITE">
        <KeyFrame Cue="0%">
          <Setter Property="Background" Value="{StaticResource UfLaunchGradient}" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Background" Value="{StaticResource UfLaunchHoverGradient}" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Tertiary outline button ("Создать аккаунт" etc): quiet graphite with
       a soft mint tint on hover instead of a neon frame. -->
  <Style Selector="Button.uf-outline">
    <Setter Property="Foreground" Value="{StaticResource UfTextDimBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource UfBtnBorderBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource UfRadiusM}" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.uf-outline /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.16" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.uf-outline:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#22242B" />
    <Setter Property="BorderBrush" Value="{StaticResource UfBtnBorderHiBrush}" />
    <Setter Property="TextBlock.Foreground" Value="{StaticResource UfTextBrush}" />
  </Style>
  <Style Selector="Button.uf-outline:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource UfBtnDownBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource UfBtnBorderBrush}" />
    <Setter Property="RenderTransform" Value="scale(0.98)" />
  </Style>
  <Style Selector="Button.uf-outline:disabled /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="#2E2C34" />
    <Setter Property="TextBlock.Foreground" Value="#7C828A" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <!-- Subtle ghost button (window chrome, icon buttons). Background
       cross-fades for a soft hover instead of snapping. -->
  <Style Selector="Button.uf-ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource UfRadiusS}" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.uf-ghost /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.uf-ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#2A2731" />
  </Style>
  <Style Selector="Button.uf-ghost:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#35323E" />
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>

  <!-- Card button (profile actions, dialogs): muted graphite surface,
       mint edge only on hover. -->
  <Style Selector="Button.uf-card">
    <Setter Property="Background" Value="{StaticResource UfBtnBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource UfBtnBorderBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource UfRadiusM}" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.uf-card /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.16" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.uf-card:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource UfBtnHiBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource UfBtnBorderHiBrush}" />
  </Style>
  <Style Selector="Button.uf-card:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource UfBtnDownBrush}" />
    <Setter Property="RenderTransform" Value="scale(0.98)" />
  </Style>

  <!-- Sidebar profile button: graphite pill. The mint tile is gone —
       only a thin mint edge on hover keeps it alive. -->
  <Style Selector="Button.uf-side">
    <Setter Property="Background" Value="#1E1C22" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#2E2C34" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.uf-side /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.16" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.uf-side:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#26242D" />
    <Setter Property="BorderBrush" Value="{StaticResource UfMintBrush}" />
  </Style>
  <Style Selector="Button.uf-side:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#2E2B36" />
    <Setter Property="RenderTransform" Value="scale(0.98)" />
  </Style>

  <!-- Round gear button docked into the profile card corner: graphite
       circle, mint icon on hover. -->
  <Style Selector="Button.uf-gear">
    <Setter Property="Background" Value="#1E1C22" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#2E2C34" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.uf-gear /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.16" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.uf-gear:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#26242D" />
    <Setter Property="BorderBrush" Value="{StaticResource UfMintBrush}" />
  </Style>
  <Style Selector="Button.uf-gear:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#2E2B36" />
    <Setter Property="RenderTransform" Value="scale(0.92)" />
  </Style>

  <!-- Profile dropdown chevron: points up when the menu is closed,
       flips down while open (uf-chevron-open toggled from code-behind
       via UiAnimations.SetClass). Same TransformOperations mechanism
       as the settings toggle knob. -->
  <Style Selector="Svg.uf-chevron">
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Svg.uf-chevron-open">
    <Setter Property="RenderTransform" Value="rotate(180deg)" />
  </Style>

  <!-- Dropdown menu row (profile menu): invisible until hovered, then a
       soft graphite wash. Danger variant glows red instead. -->
  <Style Selector="Button.uf-menu">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.uf-menu /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.uf-menu:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#2A2731" />
  </Style>
  <Style Selector="Button.uf-menu:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#35323E" />
  </Style>
  <Style Selector="Button.uf-menu-danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource UfDangerBgBrush}" />
  </Style>
  <Style Selector="Button.uf-menu-danger:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource UfDangerDownBrush}" />
  </Style>

  <!-- Text field. -->
  <Style Selector="TextBox.uf-field">
    <Setter Property="Background" Value="#16141A" />
    <Setter Property="Foreground" Value="{StaticResource UfTextBrush}" />
    <Setter Property="CaretBrush" Value="{StaticResource UfMintBrush}" />
    <Setter Property="SelectionBrush" Value="#3D5A4C" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource UfBorderBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource UfRadiusM}" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="TextBox.uf-field:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="#55525E" />
  </Style>
  <Style Selector="TextBox.uf-field:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{StaticResource UfMintBrush}" />
  </Style>

  <!-- Loading pulse (autoupdate "Булдыга собирает чанки…").
       Toggled at runtime via UiAnimations.BackgroundPulse so weak
       hardware can run a static row instead. -->
  <Style Selector="StackPanel.uf-pulse">
    <Style.Animations>
      <Animation Duration="0:0:6" IterationCount="INFINITE">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.55"/>
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="Opacity" Value="1.0"/>
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.55"/>
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Section caption. -->
  <Style Selector="TextBlock.uf-caption">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource UfTextMuteBrush}" />
  </Style>

  <!-- Card surface. -->
  <Style Selector="Border.uf-card">
    <Setter Property="Background" Value="{StaticResource UfCardBrush}" />
    <Setter Property="BorderBrush" Value="#2E2C34" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource UfRadiusL}" />
  </Style>

  <!-- Progress bars. -->
  <Style Selector="ProgressBar.uf-bar">
    <Setter Property="Background" Value="#26232C" />
    <Setter Property="Foreground" Value="{StaticResource UfAccentGradient}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="8" />
  </Style>
  <Style Selector="ProgressBar.uf-bar /template/ Border#PART_Track">
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="ProgressBar.uf-bar /template/ Border#PART_Indicator">
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style Selector="ProgressBar.uf-thin">
    <Setter Property="Background" Value="#333036" />
    <Setter Property="Foreground" Value="{StaticResource UfAccentGradient}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="MinHeight" Value="5" />
  </Style>
  <Style Selector="ProgressBar.uf-thin /template/ Border#PART_Track">
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="ProgressBar.uf-thin /template/ Border#PART_Indicator">
    <Setter Property="CornerRadius" Value="3" />
  </Style>

  <!-- Settings slider + toggles ship as full ControlThemes below
       (see Styles.Resources): plain /template/ selectors from a loose
       Style do not reach SimpleTheme template parts in this setup. -->
  <Style Selector="Slider.uf-slider">
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ToggleSwitch.uf-toggle">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Discord button on the auth page: muted blurple solid with a border,
       calm against the dark card. -->
  <Style Selector="Button.uf-discord">
    <Setter Property="Background" Value="{StaticResource UfDiscordBtnBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource UfDiscordBtnBorderBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource UfRadiusM}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.uf-discord /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.16" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.uf-discord:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource UfDiscordBtnHiBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource UfDiscordBtnBorderHiBrush}" />
  </Style>
  <Style Selector="Button.uf-discord:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource UfDiscordBtnDownBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource UfDiscordBtnBorderBrush}" />
    <Setter Property="RenderTransform" Value="scale(0.98)" />
  </Style>
  <Style Selector="Button.uf-discord:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource UfBtnDownBrush}" />
    <Setter Property="BorderBrush" Value="#2E2C34" />
    <Setter Property="TextBlock.Foreground" Value="#7C828A" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <!-- Thin overlay scrollbar: transparent track, slim graphite thumb that
       lights mint on hover. Applies app-wide to every vertical ScrollBar
       (settings panels, server list, changelog) — no per-page opt-in. -->
  <Style Selector="ScrollBar:vertical">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="8" />
    <Setter Property="MinWidth" Value="8" />
    <Setter Property="Padding" Value="2,4" />
  </Style>
  <Style Selector="ScrollBar:vertical /template/ Thumb">
    <Setter Property="Background" Value="#3A3842" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="ScrollBar:vertical:pointerover /template/ Thumb">
    <Setter Property="Background" Value="{StaticResource UfMintBrush}" />
  </Style>
  <Style Selector="ScrollBar:vertical /template/ RepeatButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Opacity" Value="0" />
  </Style>
</Styles>
