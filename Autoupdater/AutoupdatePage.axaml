<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:UnrealFrontiersLauncher"
             x:Class="UnrealFrontiersLauncher.AutoupdatePage"
             x:DataType="local:AutoupdatePageViewModel">
    <Grid>
        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" Source="/Assets/Images/backgorund2.png" />
        </Grid.Background>
        <Border Opacity="0.82">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#0B0A0E" Offset="0.0" />
                    <GradientStop Color="#121420" Offset="0.55" />
                    <GradientStop Color="#0A1F18" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="18" MaxWidth="520" Margin="24">
            <Image Source="{StaticResource UfLogoBanner}" Stretch="Uniform" MaxWidth="420"/>
            <StackPanel Spacing="2" HorizontalAlignment="Center">
                <StackPanel x:Name="PulsePanel" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="12">
                    <Image Source="../Assets/Images/roflanbuldiga.png" Width="64" Height="64"/>
                    <TextBlock Text="Булдыга собирает чанки…"
                               FontFamily="{StaticResource MontserratRegular}"
                               FontSize="14" Foreground="#8E939B" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <Border Classes="uf-card" Padding="20,16">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock FontSize="15"
                                   FontFamily="{StaticResource MontserratBold}"
                                   Grid.Column="0" Foreground="White"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="{Binding StatusText}"/>
                        <TextBlock FontFamily="{StaticResource MontserratBold}"
                                   FontSize="22" Foreground="{StaticResource UfMintBrush}"
                                   IsVisible="{Binding ShouldDisplayDownloadProgress}"
                                   Grid.Column="1"
                                   Text="{Binding ProgressValue, StringFormat={}{0:F1}%}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <ProgressBar Classes="uf-bar" Value="{Binding ProgressValue}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
