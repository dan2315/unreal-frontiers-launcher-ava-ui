<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UnrealFrontiersLauncher.App"
             xmlns:local="using:UnrealFrontiersLauncher"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <SimpleTheme/>
        <Styles>
            <Styles.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceInclude Source="/Styles/Brushes.axaml"/>
                        <ResourceInclude Source="/Styles/Settings.axaml"/>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Styles.Resources>
            <StyleInclude Source="/Styles/Controls.axaml"/>
        </Styles>
    </Application.Styles>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/Brushes.axaml"/>
                <ResourceInclude Source="/Styles/Settings.axaml"/>
            </ResourceDictionary.MergedDictionaries>

        <FontFamily x:Key="MontserratRegular">/Assets/Fonts/Montserrat-Regular.ttf#Montserrat</FontFamily>
        <FontFamily x:Key="MontserratBold">/Assets/Fonts/Montserrat-Bold.ttf#Montserrat</FontFamily>
        <FontFamily x:Key="MontserratLight">/Assets/Fonts/Montserrat-Light.ttf#Montserrat</FontFamily>

        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,50%" x:Key="DefaultGradientBrush">
            <GradientStop Color="#00FFA3" Offset="0.0" />
            <GradientStop Color="#00E5FF" Offset="0.55" />
            <GradientStop Color="#2979FF" Offset="1.0" />
        </LinearGradientBrush>

        <!-- Reborn brand logo lockups -->
        <Bitmap x:Key="UfLogoBanner">/Assets/Images/logo_banner.png</Bitmap>
        <Bitmap x:Key="UfLogoBadge">/Assets/Images/logo_badge.png</Bitmap>
        </ResourceDictionary>
    </Application.Resources>

</Application>
