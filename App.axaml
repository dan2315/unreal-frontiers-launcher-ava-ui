<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UnrealFrontiersLauncher.App"
             xmlns:local="using:UnrealFrontiersLauncher"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <SimpleTheme />
        <!-- <StyleInclude Source="avares://Citrus.Avalonia/Rust.xaml"/> -->
  </Application.Styles>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <FontFamily x:Key="MontserratRegular">/Assets/Fonts/Montserrat-Regular.ttf#Montserrat</FontFamily>
        <FontFamily x:Key="MontserratBold">/Assets/Fonts/Montserrat-Bold.ttf#Montserrat</FontFamily>
        <FontFamily x:Key="MontserratLight">/Assets/Fonts/Montserrat-Light.ttf#Montserrat</FontFamily>
        
        <LinearGradientBrush x:Key="GradientBruh" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#6d00ab" Offset="0" />
            <GradientStop Color="#2f004a" Offset="1" />
        </LinearGradientBrush>
    </Application.Resources>
  
</Application>